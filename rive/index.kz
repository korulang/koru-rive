    .{ .key = 1137, .field = 0, .name = "StateMachineListener.listenerFlags" },
};

fn typeName(key: u64) ?[:0]const u8 {
    const e = zsearch(TypeKeyEntry, key, &type_keys, struct {
        fn f(t: TypeKeyEntry) u64 { return t.key; }
    }.f) orelse return null;
    return e.name;
}

fn propEntry(key: u16) ?PropEntry {
    return zsearch(PropEntry, key, &prop_entries, struct {
        fn f(t: PropEntry) u64 { return t.key; }
    }.f);
}

// ---- .riv wire format (verified against rive-cpp src/file.cpp +
// runtime_object_reader.cpp + runtime_header.hpp) -------------------------
// header: "RIVE" | varuint major | varuint minor | varuint64 fileId |
//         varuint propertyKeys...0 | 2-bit field idx per key, u32 LE stream
// object: varuint typeKey | (varuint propKey value)* 0
// value:  field 0 = varuint64 | 1 = varuint len + bytes | 2 = f32 LE |
//         3 = u32 LE | 4 = u8

fn readVarU64(b: []const u8, pos: *usize) ?u64 {
    var v: u64 = 0;
    var s: u6 = 0;
    while (pos.* < b.len) {
        const byte = b[pos.*];
        pos.* += 1;
        v |= @as(u64, byte & 0x7f) << s;
        if (byte & 0x80 == 0) return v;
        s += 7;
        if (s >= 64) return null;
    }
    return null;
}

fn readU32(b: []const u8, pos: *usize) ?u32 {
    if (pos.* + 4 > b.len) return null;
    const v = std.mem.readInt(u32, b[pos.*..][0..4], .little);
    pos.* += 4;
    return v;
}

fn skipValue(b: []const u8, pos: *usize, field: i8) bool {
    switch (field) {
        0 => _ = readVarU64(b, pos) orelse return false,
        1 => {
            const n = readVarU64(b, pos) orelse return false;
            if (pos.* + n > b.len) return false;
            pos.* += @intCast(n);
        },
        2, 3 => {
            if (pos.* + 4 > b.len) return false;
            pos.* += 4;
        },
        4 => {
            if (pos.* + 1 > b.len) return false;
            pos.* += 1;
        },
        else => return false,
    }
    return true;
}

pub fn inspectImpl(path: []const u8) void {
    const file = std.fs.cwd().openFile(path, .{}) catch {
        std.debug.print("inspect: cannot open {s}\n", .{path});
        return;
    };
    defer file.close();
    const bytes = file.readToEndAlloc(std.heap.page_allocator, 64 * 1024 * 1024) catch {
        std.debug.print("inspect: read failed\n", .{});
        return;
    };
    defer std.heap.page_allocator.free(bytes);
    var pos: usize = 0;

    if (bytes.len < 4 or !std.mem.eql(u8, bytes[0..4], "RIVE")) {
        std.debug.print("inspect: bad fingerprint\n", .{});
        return;
    }
    pos = 4;
    const major = readVarU64(bytes, &pos) orelse return;
    const minor = readVarU64(bytes, &pos) orelse return;
    const fileId = readVarU64(bytes, &pos) orelse return;
    std.debug.print("header: RIVE v{d}.{d} fileId={d}\n", .{ major, minor, fileId });

    // ToC: property keys until 0, then 2-bit field indices from u32 stream.
    var toc_keys = std.ArrayList(u16).empty;
    defer toc_keys.deinit(std.heap.page_allocator);
    while (true) {
        const k = readVarU64(bytes, &pos) orelse return;
        if (k == 0) break;
        toc_keys.append(std.heap.page_allocator, @intCast(k)) catch return;
    }
    var toc_field = std.AutoHashMap(u16, i8).init(std.heap.page_allocator);
    defer toc_field.deinit();
    {
        var cur: u32 = 0;
        var bit: u4 = 8;
        for (toc_keys.items) |k| {
            if (bit == 8) {
                cur = readU32(bytes, &pos) orelse return;
                bit = 0;
            }
            toc_field.put(k, @intCast((cur >> bit) & 3)) catch return;
            bit += 2;
        }
    }
    std.debug.print("toc: {d} property keys\n", .{toc_keys.items.len});

    // Object stream.
    var obj_i: usize = 0;
    var unknown_types = std.AutoHashMap(u64, usize).init(std.heap.page_allocator);
    defer unknown_types.deinit();
    while (pos < bytes.len) {
        const typeKey = readVarU64(bytes, &pos) orelse {
            std.debug.print("inspect: truncated typeKey at obj {d}\n", .{obj_i});
            return;
        };
        const tn = typeName(typeKey);
        var nprops: usize = 0;
        var first_props = std.ArrayList(u8).empty;
        defer first_props.deinit(std.heap.page_allocator);
        while (true) {
            const pk = readVarU64(bytes, &pos) orelse {
                std.debug.print("inspect: truncated propKey at obj {d}\n", .{obj_i});
                return;
            };
            if (pk == 0) break;
            const pkey: u16 = @intCast(pk);
            // registry first, then the file's ToC (0-3 only)
            var field: i8 = -1;
            if (propEntry(pkey)) |pe| {
                field = pe.field;
            } else if (toc_field.get(pkey)) |tf| {
                field = tf;
            }
            if (field == -1) {
                std.debug.print("inspect: obj {d} unknown propKey {d} — stream unreadable\n", .{ obj_i, pk });
                return;
            }
            if (!skipValue(bytes, &pos, field)) {
                std.debug.print("inspect: obj {d} prop {d} value overrun\n", .{ obj_i, pk });
                return;
            }
            nprops += 1;
            if (nprops <= 6 and first_props.items.len < 200) {
                const nm = if (propEntry(pkey)) |pe| pe.name else "?";
                const s = std.fmt.allocPrint(std.heap.page_allocator, " {s}={d}", .{ nm, pk }) catch continue;
                first_props.appendSlice(std.heap.page_allocator, s) catch {};
                std.heap.page_allocator.free(s);
            }
        }
        if (tn) |name| {
            std.debug.print("obj[{d}] type={d} {s} props={d}%{s}\n", .{ obj_i, typeKey, name, nprops, first_props.items });
        } else {
            const c = unknown_types.getOrPut(typeKey) catch continue;
            c.value_ptr.* += 1;
            std.debug.print("obj[{d}] type={d} <unknown> props={d}%{s}\n", .{ obj_i, typeKey, nprops, first_props.items });
        }
        obj_i += 1;
    }
    std.debug.print("inspect: {d} objects, end pos {d}/{d}\n", .{ obj_i, pos, bytes.len });
    var it = unknown_types.iterator();
    while (it.next()) |e| {
        std.debug.print("  unknown typeKey {d} x{d}\n", .{ e.key_ptr.*, e.value_ptr.* });
    }
}

// ---- Koru surface ---------------------------------------------------------

~pub tor inspect { path: string }

~proc inspect|zig {
    inspectImpl(path);
}
