~pub tor opsdump { r: *Riv<loaded>, ab: i64, frame: i64 }
~proc opsdump|zig {
    if (frame < 0) {
        var fr: i64 = 0;
        while (fr < 60) : (fr += 1) {
            std.debug.print("=== frame {d} ===\n", .{fr});
            const recs = $mod.collectOps(r, @intCast(ab), fr, std.heap.page_allocator);
            for (recs) |rec| {
                std.debug.print("OP k={d} x1={d:.1} y1={d:.1} x2={d:.2} y2={d:.1} x3={d:.1} y3={d:.1} style={d} color={x} thick={d:.1} eo={d} a={d:.3} b={d:.3} c={d:.3} d={d:.3} e={d:.1} g={d:.1} dash={d:.1} dashOff={d:.1}\n", .{ rec.kind, rec.x1, rec.y1, rec.x2, rec.y2, rec.x3, rec.y3, rec.style, rec.color, rec.thick, rec.eo, rec.a, rec.b, rec.c, rec.d, rec.e, rec.g, rec.dash, rec.dashOff });
            }
            std.heap.page_allocator.free(recs);
        }
        return;
    }
    const recs = $mod.collectOps(r, @intCast(ab), frame, std.heap.page_allocator);
    for (recs) |rec| {
        std.debug.print("OP k={d} x1={d:.1} y1={d:.1} x2={d:.2} y2={d:.1} x3={d:.1} y3={d:.1} style={d} color={x} thick={d:.1} eo={d} a={d:.3} b={d:.3} c={d:.3} d={d:.3} e={d:.1} g={d:.1} dash={d:.1} dashOff={d:.1}\n", .{ rec.kind, rec.x1, rec.y1, rec.x2, rec.y2, rec.x3, rec.y3, rec.style, rec.color, rec.thick, rec.eo, rec.a, rec.b, rec.c, rec.d, rec.e, rec.g, rec.dash, rec.dashOff });
    }
    std.debug.print("OPSDUMP total={d}\n", .{recs.len});
}

~pub tor vmdump { r: *Riv<loaded> }
~proc vmdump|zig {
    var n427: usize = 0; var n437: usize = 0; var n441: usize = 0; var n559: usize = 0; var n435: usize = 0; var n429: usize = 0;
    for (r.objects) |o| {
        switch (o.type_key) {
            427 => n427 += 1, 437 => n437 += 1, 441 => n441 += 1,
            559 => n559 += 1, 435 => n435 += 1, 429 => n429 += 1,
            else => {},
        }
    }
    std.debug.print("counts 427={d} 437={d} 441={d} 559={d} 435={d} 429={d}\n", .{ n427, n437, n441, n559, n435, n429 });
    // 427 items: vmid prop549 + index
    for (r.objects, 0..) |o, i| {
        if (o.type_key != 427) continue;
        const vmid = propU(o.props, 549, -1);
        std.debug.print("item[{d}] obj={d} vmid={d} parent={d}\n", .{ n427, i, vmid, o.parent_obj });
    }
    // artboards with prop583
    for (r.objects, 0..) |o, i| {
        if (o.type_key != 1) continue;
        if (propU(o.props, 583, -1) >= 0) {
            std.debug.print("ab obj={d} prop583={d}\n", .{ i, propU(o.props, 583, -1) });
        }
    }
    // VM instances/lists: dump all props
    for (r.objects, 0..) |o, i| {
        if (o.type_key != 437 and o.type_key != 441 and o.type_key != 435 and o.type_key != 429) continue;
        std.debug.print("vmtype {d} obj={d} parent={d} props:", .{ o.type_key, i, o.parent_obj });
        for (o.props) |p| {
            switch (p.value) {
                .uint => |u| std.debug.print(" k{d}={d}", .{ p.key, u }),
                .dbl => |x| std.debug.print(" k{d}={d:.2}", .{ p.key, x }),
                .boolean => |b| std.debug.print(" k{d}={s}", .{ p.key, if (b) "true" else "false" }),
                .color => |c| std.debug.print(" k{d}={x}", .{ p.key, c }),
                .bytes => |b| std.debug.print(" k{d}=<{d}B>", .{ p.key, b.len }),
            }
        }
        std.debug.print("\n", .{});
        // who references this object? scan all props for uint==i
        for (r.objects, 0..) |q, qi| {
            if (qi == i) continue;
            for (q.props) |p| {
                if (p.value == .uint and p.value.uint == @as(u64, @intCast(i))) {
                    std.debug.print("  ref: obj{d} type{d} key{d}\n", .{ qi, q.type_key, p.key });
                }
            }
        }
    }
}

~pub tor cl1dump { r: *Riv<loaded> }
~proc cl1dump|zig {
    // children of obj6 (441 list) + obj6 full props + SM objects (53-59) props
    for (r.objects, 0..) |o, i| {
        if (o.parent_obj == 6 or i == 6) {
            std.debug.print("obj{d} type{d} parent{d} props:", .{ i, o.type_key, o.parent_obj });
            for (o.props) |p| switch (p.value) {
                .uint => |u| std.debug.print(" k{d}={d}", .{ p.key, u }),
                .dbl => |x| std.debug.print(" k{d}={d:.2}", .{ p.key, x }),
                .boolean => |b| std.debug.print(" k{d}={s}", .{ p.key, if (b) "true" else "false" }),
                .color => |c| std.debug.print(" k{d}={x}", .{ p.key, c }),
                .bytes => |b| std.debug.print(" k{d}=<{d}B>", .{ p.key, b.len }),
            };
            std.debug.print("\n", .{});
        }
        if (o.type_key >= 53 and o.type_key <= 59) {
            std.debug.print("SM obj{d} type{d} parent{d} props:", .{ i, o.type_key, o.parent_obj });
            for (o.props) |p| switch (p.value) {
                .uint => |u| std.debug.print(" k{d}={d}", .{ p.key, u }),
                .dbl => |x| std.debug.print(" k{d}={d:.2}", .{ p.key, x }),
                .boolean => |b| std.debug.print(" k{d}={s}", .{ p.key, if (b) "true" else "false" }),
                .color => |c| std.debug.print(" k{d}={x}", .{ p.key, c }),
                .bytes => |b| std.debug.print(" k{d}=<{d}B>", .{ p.key, b.len }),
            };
            std.debug.print("\n", .{});
        }
    }
}

~pub tor graphdump { r: *Riv<loaded> }
~proc graphdump|zig {
    dumpGraph(r);
}

// ---- riv2k materialize: canonical spec -> Riv ------------------------------
fn specTok(spec: []const u8, pos: *usize) []const u8 {
    while (pos.* < spec.len and (spec[pos.*] == ' ' or spec[pos.*] == '\n' or spec[pos.*] == '\r' or spec[pos.*] == '\t')) pos.* += 1;
    const s = pos.*;
    while (pos.* < spec.len and spec[pos.*] != ' ' and spec[pos.*] != '\n' and spec[pos.*] != '\r' and spec[pos.*] != '\t') pos.* += 1;
    return spec[s..pos.*];
}
fn specInt(spec: []const u8, pos: *usize) i64 { return std.fmt.parseInt(i64, specTok(spec, pos), 10) catch -1; }
fn specU32(spec: []const u8, pos: *usize) u32 { return std.fmt.parseInt(u32, specTok(spec, pos), 16) catch 0; }
fn specHex(spec: []const u8, pos: *usize, n: usize) ?[]u8 {
    const t = specTok(spec, pos);
    if (t.len != n * 2) return null;
    const out = std.heap.page_allocator.alloc(u8, n) catch return null;
    for (out, 0..) |*b, i| {
        b.* = std.fmt.parseInt(u8, t[i * 2 .. i * 2 + 2], 16) catch {
            std.heap.page_allocator.free(out);
            return null;
        };
    }
    return out;
}

fn materializeGraph(spec: []const u8) ?*Riv {
    const alloc = std.heap.page_allocator;
    var pos: usize = 0;
    if (!std.mem.eql(u8, specTok(spec, &pos), "G")) return null;
    const nobj = specInt(spec, &pos);
    if (nobj < 0 or !std.mem.eql(u8, specTok(spec, &pos), "B")) return null;
    const nbytes = specInt(spec, &pos);
    const bytes = alloc.alloc(u8, @intCast(@max(nbytes, 0))) catch return null;
    if (nbytes > 0) {
        const hb = specHex(spec, &pos, @intCast(nbytes)) orelse {
            alloc.free(bytes);
            return null;
        };
        @memcpy(bytes, hb);
        alloc.free(hb);
    }
    const objects = alloc.alloc(RivObj, @intCast(nobj)) catch return null;
    for (objects) |*o| {
        if (!std.mem.eql(u8, specTok(spec, &pos), "O")) return null;
        o.type_key = @intCast(@max(specInt(spec, &pos), 0));
        o.slot = specInt(spec, &pos);
        o.parent = specInt(spec, &pos);
        o.parent_obj = specInt(spec, &pos);
        o.style_obj = specInt(spec, &pos);
        const nprops = specInt(spec, &pos);
        if (nprops < 0) return null;
        o.type_name = typeName(o.type_key);
        const props = alloc.alloc(Prop, @intCast(nprops)) catch return null;
        for (props) |*p| {
            if (!std.mem.eql(u8, specTok(spec, &pos), "P")) return null;
            p.key = @intCast(@max(specInt(spec, &pos), 0));
            p.field = @intCast(specInt(spec, &pos));
            const kind = specTok(spec, &pos);
            if (std.mem.eql(u8, kind, "u")) {
                p.value = .{ .uint = std.fmt.parseInt(u64, specTok(spec, &pos), 10) catch return null };
            } else if (std.mem.eql(u8, kind, "d")) {
                p.value = .{ .dbl = @bitCast(specU32(spec, &pos)) };
            } else if (std.mem.eql(u8, kind, "c")) {
                p.value = .{ .color = specU32(spec, &pos) };
            } else if (std.mem.eql(u8, kind, "b")) {
                p.value = .{ .boolean = specInt(spec, &pos) != 0 };
            } else if (std.mem.eql(u8, kind, "x")) {
                const n = specInt(spec, &pos);
                if (n < 0) return null;
                p.value = .{ .bytes = specHex(spec, &pos, @intCast(n)) orelse return null };
            } else return null;
            if (propEntry(p.key)) |pe| {
                p.name = pe.name;
            } else {
                p.name = "?";
            }
        }
        o.props = props;
    }
    const riv = alloc.create(Riv) catch return null;
    riv.bytes = bytes;
    riv.objects = objects;
    return riv;
}

~pub tor fromgraph { spec: string }
| loaded *Riv<loaded!>
| failed string

~proc fromgraph|zig {
    const r = materializeGraph(spec) orelse return .{ .failed = "bad spec" };
    return .{ .loaded = r };
}

// fromfile: dev/verification surface — load a graphdump spec from disk
// (parity probes, emitter bring-up). The shipped path is fromgraph with
// the spec embedded in the generated module.
~pub tor fromfile { path: string }
| loaded *Riv<loaded!>
| failed string

~proc fromfile|zig {
    const bytes = std.fs.cwd().readFileAlloc(std.heap.page_allocator, path, 1 << 28) catch return .{ .failed = "cannot read spec" };
    defer std.heap.page_allocator.free(bytes);
    const r = materializeGraph(bytes) orelse return .{ .failed = "bad spec" };
    return .{ .loaded = r };
}

~pub tor corpusdump { r: *Riv<loaded> }
~proc corpusdump|zig {
    // print artboard map first
    for (r.objects, 0..) |o, i| {
        if (o.type_key != 1) continue;
        var nm: []const u8 = "?";
        for (o.props) |p| {
            if (p.key == 4) switch (p.value) { .bytes => |b| nm = b, else => {} };
        }
        std.debug.print("AB idx={d} name='{s}'\n", .{ i, nm });
    }
    // per artboard x frame ops
    for (r.objects, 0..) |o, abi| {
        if (o.type_key != 1) continue;
        var fr: i64 = 0;
        while (fr < 30) : (fr += 1) {
            std.debug.print("=== ab {d} fr {d} ===\n", .{ abi, fr });
            const recs = $mod.collectOps(r, @intCast(abi), fr, std.heap.page_allocator);
            for (recs) |rec| {
                std.debug.print("OP k={d} x1={d:.4} y1={d:.4} x2={d:.4} y2={d:.4} x3={d:.4} y3={d:.4} style={d} color={x} thick={d:.4} eo={d} a={d:.4} b={d:.4} c={d:.4} d={d:.4} e={d:.4} g={d:.4}\n", .{ rec.kind, rec.x1, rec.y1, rec.x2, rec.y2, rec.x3, rec.y3, rec.style, rec.color, rec.thick, rec.eo, rec.a, rec.b, rec.c, rec.d, rec.e, rec.g });
            }
            std.heap.page_allocator.free(recs);
        }
    }
}

~pub tor vertdump { r: *Riv<loaded>, ab: i64, frame: i64 }
~proc vertdump|zig {
    const alloc = std.heap.page_allocator;
    // find shape objects under ab, then their vertex children
    for (r.objects, 0..) |o, i| {
        if (o.type_key < 5 or o.type_key > 36) continue;
        if (!isVertexType(@intCast(o.type_key))) continue;
        const k82 = propFAnim(r, &r.objects[i], 82, -999, frame);
        const k83 = propFAnim(r, &r.objects[i], 83, -999, frame);
        const s82 = propF(o.props, 82, -999);
        const s83 = propF(o.props, 83, -999);
        const kf82 = hasKeyframed(r, r.objects[i].slot, 82);
        const kf83 = hasKeyframed(r, r.objects[i].slot, 83);
        std.debug.print("vert obj={d} type{d} slot={d} k82 anim={d:.4} static={d:.4} kf={} | k83 anim={d:.4} static={d:.4} kf={}\n", .{ i, o.type_key, o.slot, k82, s82, kf82, k83, s83, kf83 });
        const vp = vertPosA(r, &r.objects[i], frame);
        const vi2 = vertInA(r, &r.objects[i], frame);
        const vo = vertOutA(r, &r.objects[i], frame);
        std.debug.print("COMP obj={d} pos=({d:.4},{d:.4}) in=({d:.4},{d:.4}) out=({d:.4},{d:.4})\n", .{ i, vp.x, vp.y, vi2.x, vi2.y, vo.x, vo.y });
        std.debug.print("vert obj={d} type{d} parent={d} props:", .{ i, o.type_key, o.parent_obj });
        for (o.props) |p| switch (p.value) {
            .uint => |u| std.debug.print(" k{d}={d}", .{ p.key, u }),
            .dbl => |x| std.debug.print(" k{d}={d:.4}", .{ p.key, x }),
            .boolean => |b| std.debug.print(" k{d}={s}", .{ p.key, if (b) "t" else "f" }),
            else => {},
        };
        std.debug.print("\n", .{});
    }
    _ = alloc; _ = ab; _ = frame;
}

~pub tor abnames { r: *Riv<loaded> }
~pub tor smdump { r: *Riv<loaded> }

~proc smdump|zig {
    for (r.objects, 0..) |o, i| {
        const tn = o.type_name orelse "?";
        if (o.type_key != 427 and o.type_key != 559 and o.type_key != 19 and o.type_key != 23) continue;
        var nm: []const u8 = "?";
        for (o.props) |p| {
            if (p.key == 4) switch (p.value) { .bytes => |b| nm = b, else => {} };
        }
        std.debug.print("obj {d} type={s} name='{s}' parent={d} parent_obj={d} props={d}\n", .{ i, tn, nm, o.parent, o.parent_obj, o.props.len });
        for (o.props) |p| {
            std.debug.print("  prop key={d} val={any}\n", .{ p.key, p.value });
        }
    }
}

~pub tor bindump { r: *Riv<loaded> }
~proc bindump|zig {
    const alloc = std.heap.page_allocator;
    for (r.objects, 0..) |o, i| {
        const tn = o.type_name orelse "?";
        std.debug.print("obj {d} type={d}:{s} parent={d} parent_obj={d} slot={d} props={d}\n", .{ i, o.type_key, tn, o.parent, o.parent_obj, o.slot, o.props.len });
        for (o.props) |p| {
            switch (p.value) {
                .uint => |u| std.debug.print("  k{d} {s} = {d}\n", .{ p.key, p.name, u }),
                .dbl => |x| std.debug.print("  k{d} {s} = {d:.4}\n", .{ p.key, p.name, x }),
                .boolean => |b| std.debug.print("  k{d} {s} = {s}\n", .{ p.key, p.name, if (b) "true" else "false" }),
                .color => |c| std.debug.print("  k{d} {s} = 0x{x:0>8}\n", .{ p.key, p.name, c }),
                .bytes => |b| {
                    // varint-list keys decode as id lists; text keys print raw
                    const isVarintKey = p.key == 588 or p.key == 920 or p.key == 711 or p.key == 866 or p.key == 963;
                    if (isVarintKey) {
                        var pos: usize = 0;
                        var ids = std.ArrayList(u64).empty;
                        while (pos < b.len) {
                            const v = readVarU64(b, &pos) orelse break;
                            ids.append(alloc, v) catch break;
                        }
                        std.debug.print("  k{d} {s} = varints{any}\n", .{ p.key, p.name, ids.items });
                        ids.deinit(alloc);
                    } else {
                        var printable = b.len > 0;
                        for (b) |ch| {
                            if (ch < 0x20 and ch != 0x0A and ch != 0x0D and ch != 0x09) { printable = false; break; }
                        }
                        if (printable and b.len < 4000) {
                            std.debug.print("  k{d} {s} = '{s}'\n", .{ p.key, p.name, b });
                        } else {
                            const n = @min(b.len, 32);
                            var hex = std.ArrayList(u8).empty;
                            for (b[0..n]) |ch| {
                                hex.appendSlice(alloc, std.fmt.allocPrint(alloc, "{x:0>2}", .{ch}) catch "") catch {};
                            }
                            std.debug.print("  k{d} {s} = <{d}B> {s}\n", .{ p.key, p.name, b.len, hex.items });
                            hex.deinit(alloc);
                        }
                    }
                },
            }
        }
    }
}

~proc abnames|zig {
    for (r.objects, 0..) |o, i| {
        if (o.type_key != 1) continue;
        var nm: []const u8 = "?";
        for (o.props) |p| {
            if (p.key == 4) {
                switch (p.value) {
                    .bytes => |b| nm = b,
                    else => {},
                }
            }
        }
        std.debug.print("AB idx={d} name='{s}' w={d:.0} h={d:.0}\n", .{ i, nm, propF(o.props, 7, 0), propF(o.props, 8, 0) });
    }
}

// ---- draws: structured draw records for canvas replay ----
const DrawRec = struct { style: i64, color: u32, thick: f64, join: i64, cap: i64, eo: i64, a: f64, b: f64, c: f64, d: f64, e: f64, g: f64, nv: usize, verbs: []u8, pts: []f64 };
fn collectDraws(r: *Riv, abIdx: usize, frame: i64, alloc: std.mem.Allocator) []DrawRec {
    const cf: i64 = if (frame >= 0) frame else if (g_cframe > 0) g_cframe else -1;
    var out = std.ArrayList(DrawRec).empty;
    errdefer out.deinit(alloc);
    var aw0: f32 = 0; var ah0: f32 = 0;
    for (r.objects, 0..) |o, i| {
        if (o.type_key == 1 and i == abIdx) { aw0 = propF(o.props, 7, 0); ah0 = propF(o.props, 8, 0); }
    }
    for (r.objects, 0..) |so, si| {
        if (so.type_key != 3) continue;
        if (owningArtboard(r, si) != abIdx) continue;
        if (std.posix.getenv("RIVE_SKIP_TGT") != null and (si == 27 or si == 30)) continue;
        var pathVs = std.ArrayList(PV).empty;
        var verbs = std.ArrayList(u8).empty;
        var pts = std.ArrayList(V2).empty;
        defer pathVs.deinit(alloc); defer verbs.deinit(alloc); defer pts.deinit(alloc);
        var closed = false; var pathFR: i64 = -1;
        for (r.objects, 0..) |*c, ci| {
            if (c.parent_obj != @as(i64, @intCast(si))) continue;
            if (propU(c.props, 128, @as(i64, -1)) >= 0) pathFR = propU(c.props, 128, 0);
            const cm = pathSpaceMat(r, ci, si, if (frame >= 0) frame else -1);
            const pvStart = pathVs.items.len;
            if (isVertexType(c.type_key)) {
                pathVs.append(alloc, fileVert(r, c, if (frame >= 0) frame else -1)) catch {};
            } else if (c.type_key == 16) {
                for (r.objects) |*gv| {
                    if (gv.parent_obj == @as(i64, @intCast(ci)) and isVertexType(gv.type_key)) {
                        pathVs.append(alloc, fileVert(r, gv, if (frame >= 0) frame else -1)) catch {};
                    }
                }
            } else if (synthParametric(r, c, &pathVs, alloc, if (frame >= 0) frame else -1)) {
                closed = true;
            }
            for (pathVs.items[pvStart..]) |*pv| xformPV(cm, pv);
        }
        if (pathVs.items.len < 2) continue;
        buildPath(pathVs.items, closed, &verbs, &pts, alloc);
        if (verbs.items.len == 0) continue;
        const w = effectiveWorld(r, si, frame);
        var flat = std.ArrayList(f64).empty;
        defer flat.deinit(alloc);
        for (pts.items) |p| { flat.append(alloc, p.x) catch {}; flat.append(alloc, p.y) catch {}; }
        const flatOwned = flat.toOwnedSlice(alloc) catch continue;
        const verbsOwned = verbs.toOwnedSlice(alloc) catch continue;
        for (r.objects, 0..) |*c, pi| {
            if (c.parent_obj != @as(i64, @intCast(si))) continue;
            if (c.type_key != 20 and c.type_key != 24) continue;
            // isVisible(41): false/0 paints emit nothing — rive-cpp culls
            // them before raster (image-oracle overdraw fix).
            if (propByKey(c.props, 41)) |v| switch (v) {
                .boolean => |b| if (!b) continue,
                .dbl => |x| if (x == 0) continue,
                else => {},
            };
            var color: u32 = 0xFF747474;
            for (r.objects, 0..) |*g, gi| {
                if (g.type_key == 18 and g.parent_obj == @as(i64, @intCast(pi))) { color = propColorAnimOr(r, g, 37, cf, 0xFF747474); _ = gi; }
            }
            // WorldTransformComponent.opacity(18) keyframes scale alpha;
            // opacity 0 = object hidden by SM — skip the draw entirely.
            const op: f32 = if (frame >= 0 and hasKeyframed(r, so.slot, 18)) keyframedValue(r, so.slot, 18, frame) else propF(so.props, 18, 1);
            if (op <= 0) continue;
            const oa: u32 = @intFromFloat(@min(255, @as(f32, @floatFromInt((color >> 24) & 0xFF)) * op));
            color = (color & 0x00FFFFFF) | (oa << 24);
            if (((color >> 24) & 0xFF) == 0) {
                if (std.posix.getenv("RIVE_TRACE_SKIP") != null) std.debug.print("SKIP obj={d} paint={d} why=alpha0 t={d:.1},{d:.1}\n", .{ si, pi, w[4], w[5] });
            }
            // Alpha-0 paint: draw.path would rasterize invisible pixels —
            // skip the op stream entirely (same pixels, fewer ops).
            if (((color >> 24) & 0xFF) == 0) continue;
            const isStroke = c.type_key == 24;
            const style: i64 = if (isStroke) 0 else 1;
            const thick = if (isStroke) propF(c.props, 47, 1) else 0;
            const join = if (isStroke) propU(c.props, 49, 999) else @as(i64, -1);
            const cap = if (isStroke) propU(c.props, 48, 999) else @as(i64, -1);
            const fr = if (pathFR >= 0) pathFR else if (isStroke) @as(i64, 2) else propU(c.props, 40, 0);
            out.append(alloc, .{ .style = style, .color = color, .thick = thick, .join = join, .cap = cap, .eo = if (fr == 1) 1 else 0, .a = w[0], .b = w[1], .c = w[2], .d = w[3], .e = w[4], .g = w[5], .nv = verbsOwned.len, .verbs = verbsOwned, .pts = flatOwned }) catch {};
        }
    }
    return out.items;
}

~pub tor draws { r: *Riv<loaded>, ab: i64, frame: i64 } -> [DrawRec]
~proc draws|zig {
    return collectDraws(r, @intCast(ab), frame, std.heap.page_allocator);
}




// ---- ops: flat command list for canvas replay (OpRec) ----
// kind: 0=open 1=move 2=line 3=quad 4=cubic 5=close 6=pushmat 7=popmat 8=draw 9=clippush 10=clippop
const OpRec = struct { kind: i64, x1: f64, y1: f64, x2: f64, y2: f64, x3: f64, y3: f64, style: i64, color: u32, thick: f64, join: i64, cap: i64, eo: i64, a: f64, b: f64, c: f64, d: f64, e: f64, g: f64, dash: f64, dashOff: f64 };
fn op0(kind: i64) OpRec { return .{ .kind = kind, .x1 = 0, .y1 = 0, .x2 = 0, .y2 = 0, .x3 = 0, .y3 = 0, .style = 0, .color = 0, .thick = 0, .join = 0, .cap = 0, .eo = 0, .a = 0, .b = 0, .c = 0, .d = 0,  .e = 0, .g = 0, .dash = 0, .dashOff = 0 }; }

// Embedded image blobs for kind-11 image ops — FileAssetContents bytes
// ride a side table; OpRec.kind==11 carries the blob index + draw rect.
var imgBlobs: std.ArrayList([]const u8) = .empty;
~pub tor imgblob { i: f64 } -> string
~proc imgblob|zig {
    const b = imgBlobs.items[@intFromFloat(i)];
    return b;
}

// Dash decode: Dash(507) length(692)/isPct(693) + DashPath(506)
// offset(690)/offsetIsPct(691) — children of the stroke paint.
const DashInfo = struct { len: f64, off: f64 };
fn dashOf(r: *const Riv, paintIdx: usize) DashInfo {
    var res: DashInfo = .{ .len = 0, .off = 0 };
    for (r.objects, 0..) |d, di| {
        if (d.parent_obj != @as(i64, @intCast(paintIdx))) continue;
        if (d.type_key == 507) {
            const L = propF(d.props, 692, 0);
            const pct = propU(d.props, 693, 0) != 0;
            _ = pct; // percentage-of-path dash: treat as absolute px v1 (named delta)
            if (L > 0) res.len = L;
        } else if (d.type_key == 506) {
            res.off = propF(d.props, 690, 0);
        }
        _ = di;
    }
    return res;
}

// Joystick.apply scrub (INPUT_STACK.md slice 2): for each Joystick
// component in the artboard, read its animated x/y props, map to
// [0,1], and evaluate the referenced x/y animations' keyframe tracks
// at the scrub time — recording (slot,key)->value overrides that
// keyframedValue consults before live sampling. SM-inactive
// animations (yAnim/xAnim) are evaluated via ignoreOwner.
fn animDurationFrames(r: *const Riv, animIdx: i64) f32 {
    const ao = &r.objects[@intCast(animIdx)];
    if (propByKey(ao.props, 57)) |v| {
        return switch (v) { .uint => |u| @as(f32, @floatFromInt(u)), .dbl => |d| d, else => 0 };
    }
    var mx: f32 = 0;
    for (r.objects, 0..) |o, oi| {
        if (o.type_key != 30) continue;
        if (animOwnerOf(r, oi) != animIdx) continue;
        const f = @as(f32, @floatFromInt(propU(o.props, 67, 0)));
        if (f > mx) mx = f;
    }
    return mx;
}

fn scrubAnimAxis(r: *const Riv, animIdx: i64, axis: f32) void {
    const dur = animDurationFrames(r, animIdx);
    if (dur <= 0) return;
    const scrubT = ((axis + 1.0) / 2.0) * dur;
    var pendSlot: i64 = -1;
    for (r.objects, 0..) |mo, mi| {
        if (mo.type_key == 25) {
            pendSlot = if (propByKey(mo.props, 51)) |v| switch (v) { .uint => |u| @intCast(u), else => -1 } else -1;
            continue;
        }
        if (mo.type_key == 26) {
            if (std.posix.getenv("RIVE_TRACE_SCRUB") != null) std.debug.print("  trk mi={d} pend={d} owner={d} want={d}\n", .{ mi, pendSlot, animOwnerOf(r, mi), animIdx });
            if (propByKey(mo.props, 53)) |v| {
                const key: i64 = switch (v) { .uint => |u| @intCast(u), else => -1 };
                if (pendSlot >= 0 and key >= 0 and animOwnerOf(r, mi) == animIdx) {
                    const val = keyframedValueT(r, pendSlot, @as(u16, @intCast(key)), scrubT, true);
                    g_scrubOverrides.append(std.heap.page_allocator, .{ .slot = pendSlot, .key = @as(u16, @intCast(key)), .val = val }) catch {};
                    if (std.posix.getenv("RIVE_TRACE_SCRUB") != null) std.debug.print("scrub anim={d} slot={d} key={d} t={d:.2} val={d:.3}\n", .{ animIdx, pendSlot, key, scrubT, val });
                }
            }
            pendSlot = -1;
            continue;
        }
        if (!isKfClusterObj(&mo)) pendSlot = -1;
    }
}

fn computeScrubOverrides(r: *const Riv, abIdx: i64, frame: i64) void {
    var anims = std.ArrayList(i64).empty;
    defer anims.deinit(std.heap.page_allocator);
    for (r.objects, 0..) |ao, ai| {
        if (ao.type_key == 31 and animArtboard(r, ai) == abIdx) anims.append(std.heap.page_allocator, @intCast(ai)) catch {};
    }
    const dbg = std.posix.getenv("RIVE_TRACE_SCRUB") != null;
    if (dbg) std.debug.print("scrubscan ab={d} anims={d}\n", .{ abIdx, anims.items.len });
    for (r.objects, 0..) |jo, ji| {
        if (jo.type_key != 148) continue;
        if (owningArtboard(r, ji) != abIdx) continue;
        if (dbg) std.debug.print("  joy ji={d} slot={d}\n", .{ ji, jo.slot });
        const flags = propU(jo.props, 312, 0);
        const y = keyframedValue(r, jo.slot, 300, frame);
        const x = keyframedValue(r, jo.slot, 299, frame);
        const yId = propU(jo.props, 302, -1);
        const xId = propU(jo.props, 301, -1);
        if (dbg) std.debug.print("    yId={d} xId={d} flags={d} y={d:.3}\n", .{ yId, xId, flags, y });
        if (yId >= 0 and yId < @as(i64, @intCast(anims.items.len))) {
            const axis = if (flags & 2 != 0) -y else y;
            scrubAnimAxis(r, anims.items[@as(usize, @intCast(yId))], axis);
        }
        if (xId >= 0 and xId < @as(i64, @intCast(anims.items.len))) {
            const axis = if (flags & 1 != 0) -x else x;
            scrubAnimAxis(r, anims.items[@as(usize, @intCast(xId))], axis);
        }
    }
}

fn collectArtboardOps(r: *Riv, abIdx: usize, frame: i64, alloc: std.mem.Allocator, out: *std.ArrayList(OpRec)) void {
    const scrubBase = g_scrubOverrides.items.len;
    computeScrubOverrides(r, @as(i64, @intCast(abIdx)), frame);
    if (std.posix.getenv("RIVE_TRACE_ABIND") != null) {
        for (r.objects, 0..) |so, si| {
            if (so.type_key == 621 and owningArtboard(r, si) == @as(i64, @intCast(abIdx))) {
                const bid = boundScriptArtboardId(r, si) orelse propU(so.props, 876, -1);
                std.debug.print("abind sia={d} ab={d} artboardId={d}\n", .{ si, abIdx, bid });
            }
        }
    }
    const abEntryOps = out.items.len;
    defer if (std.posix.getenv("RIVE_TRACE_NEST") != null) std.debug.print("abops ab={d} depth={d} emitted={d}\n", .{ abIdx, g_abDepth, out.items.len - abEntryOps });
    // Rows pass frame=-1; g_cframe carries the host frame for colors only.
    // Host frame 0 = pre-animation: fall back to -1 so keyframed colors
    // hold their base value (cl2 t1 gray, not the kf end state).
    const cf: i64 = if (frame >= 0) frame else if (g_cframe > 0) g_cframe else -1;
    var aw0: f32 = 0; var ah0: f32 = 0;
    for (r.objects, 0..) |o, i| {
        if (o.type_key == 1 and i == abIdx) { aw0 = propF(o.props, 7, 0); ah0 = propF(o.props, 8, 0); }
    }
    // Artboard default clip (prop 196, default true): bounds rect wraps
    // all artboard content — clipPath op in golden, clip.push/pop in canvas.
    var clipOn = true;
    var layoutClip = false;
    for (r.objects, 0..) |o, i| {
        if (o.type_key == 1 and i == abIdx) {
            if (propByKey(o.props, 196)) |v| clipOn = switch (v) { .boolean => |b| b, .dbl => |x| x != 0, else => true };
        }
    }
    for (r.objects, 0..) |*lc, lci| {
        if (lc.type_key == 409 and lc.parent_obj == @as(i64, @intCast(abIdx))) {
            if (propByKey(lc.props, 196)) |v| { clipOn = switch (v) { .boolean => |b| b, .dbl => |x| x != 0, else => clipOn }; layoutClip = true; }
            _ = lci;
        }
    }
    if (clipOn) {
        out.append(alloc, op0(0)) catch {};
        var c0 = op0(1); c0.x1 = 0; c0.y1 = 0; out.append(alloc, c0) catch {};
        var c1 = op0(2); c1.x1 = @floatCast(aw0); c1.y1 = 0; out.append(alloc, c1) catch {};
        var c2 = op0(2); c2.x1 = @floatCast(aw0); c2.y1 = @floatCast(ah0); out.append(alloc, c2) catch {};
        // 4th corner is required for ANY artboard clip: a 3-corner clip is a
        // triangle and clips away half the artboard. (The text dump keeps the
        // golden "5/3 packing" separately; this is the replayed geometry.)
        var c3 = op0(2); c3.x1 = 0; c3.y1 = @floatCast(ah0); out.append(alloc, c3) catch {};
        out.append(alloc, op0(5)) catch {};
        var cpm = op0(6); cpm.a = 1; cpm.d = 1; out.append(alloc, cpm) catch {};
        var cp = op0(9); cp.eo = 0; out.append(alloc, cp) catch {};
        out.append(alloc, op0(7)) catch {};
    }
    // Artboard-level paints: Fill/Stroke parented directly to the
    // Artboard paints the backdrop rect (cl2 Main obj22 -> 0xff313131;
    // without this the canvas clear shows through as magenta). 409-
    // parented fills stay with the layout-box pass below; shape/137
    // parents have their own paths.
    for (r.objects, 0..) |*c, pi| {
        if (c.type_key != 20 and c.type_key != 24) continue;
        if (c.parent_obj != @as(i64, @intCast(abIdx))) continue;
        if (propByKey(c.props, 41)) |v| switch (v) {
            .boolean => |b| if (!b) continue,
            .dbl => |x| if (x == 0) continue,
            else => {},
        };
        var color: u32 = 0;
        for (r.objects) |*g| {
            if (g.parent_obj == @as(i64, @intCast(pi)) and g.type_key == 18) color = propColorAnimOr(r, g, 37, cf, 0xFF747474);
        }
        if (((color >> 24) & 0xFF) == 0) continue;
        var rtl: f32 = 0; var rtr: f32 = 0; var rbr: f32 = 0; var rbl: f32 = 0;
        for (r.objects, 0..) |st, sti| {
            if (propByKey(st.props, 640) == null) continue;
            if (owningArtboard(r, sti) != abIdx) continue;
            rtl = propF(st.props, 640, 0);
            rtr = propF(st.props, 641, rtl); rbl = propF(st.props, 642, rtl); rbr = propF(st.props, 643, rtl);
            break;
        }
        const rmax = @min(aw0, ah0) * 0.5;
        const ctl = @min(rtl, rmax); const ctr = @min(rtr, rmax);
        const cbr = @min(rbr, rmax); const cbl = @min(rbl, rmax);
        const k: f32 = 0.5522847498;
        out.append(alloc, op0(0)) catch {};
        if (ctl + ctr + cbr + cbl > 0) {
            var m0 = op0(1); m0.x1 = @floatCast(ctl); m0.y1 = 0; out.append(alloc, m0) catch {};
            var t1 = op0(2); t1.x1 = @floatCast(aw0 - ctr); t1.y1 = 0; out.append(alloc, t1) catch {};
            if (ctr > 0) { var c1 = op0(4); c1.x1 = @floatCast(aw0 - ctr + ctr * k); c1.y1 = 0; c1.x2 = @floatCast(aw0); c1.y2 = @floatCast(ctr * (1 - k)); c1.x3 = @floatCast(aw0); c1.y3 = @floatCast(ctr); out.append(alloc, c1) catch {}; }
            else { var l1 = op0(2); l1.x1 = @floatCast(aw0); l1.y1 = 0; out.append(alloc, l1) catch {}; }
            var t2 = op0(2); t2.x1 = @floatCast(aw0); t2.y1 = @floatCast(ah0 - cbr); out.append(alloc, t2) catch {};
            if (cbr > 0) { var c2 = op0(4); c2.x1 = @floatCast(aw0); c2.y1 = @floatCast(ah0 - cbr + cbr * k); c2.x2 = @floatCast(aw0 - cbr + cbr * k); c2.y2 = @floatCast(ah0); c2.x3 = @floatCast(aw0 - cbr); c2.y3 = @floatCast(ah0); out.append(alloc, c2) catch {}; }
            else { var l2 = op0(2); l2.x1 = @floatCast(aw0); l2.y1 = @floatCast(ah0); out.append(alloc, l2) catch {}; }
            var t3 = op0(2); t3.x1 = @floatCast(cbl); t3.y1 = @floatCast(ah0); out.append(alloc, t3) catch {};
            if (cbl > 0) { var c3 = op0(4); c3.x1 = @floatCast(cbl - cbl * k); c3.y1 = @floatCast(ah0); c3.x2 = 0; c3.y2 = @floatCast(ah0 - cbl + cbl * k); c3.x3 = 0; c3.y3 = @floatCast(ah0 - cbl); out.append(alloc, c3) catch {}; }
            else { var l3 = op0(2); l3.x1 = 0; l3.y1 = @floatCast(ah0); out.append(alloc, l3) catch {}; }
            var t4 = op0(2); t4.x1 = 0; t4.y1 = @floatCast(ctl); out.append(alloc, t4) catch {};
            if (ctl > 0) { var c4 = op0(4); c4.x1 = 0; c4.y1 = @floatCast(ctl - ctl * k); c4.x2 = @floatCast(ctl - ctl * k); c4.y2 = 0; c4.x3 = @floatCast(ctl); c4.y3 = 0; out.append(alloc, c4) catch {}; }
            else { var l4 = op0(2); l4.x1 = 0; l4.y1 = 0; out.append(alloc, l4) catch {}; }
        } else {
            var b0 = op0(1); b0.x1 = 0; b0.y1 = 0; out.append(alloc, b0) catch {};
            var b1 = op0(2); b1.x1 = @floatCast(aw0); b1.y1 = 0; out.append(alloc, b1) catch {};
            var b2 = op0(2); b2.x1 = @floatCast(aw0); b2.y1 = @floatCast(ah0); out.append(alloc, b2) catch {};
            var b3 = op0(2); b3.x1 = 0; b3.y1 = @floatCast(ah0); out.append(alloc, b3) catch {};
        }
        out.append(alloc, op0(5)) catch {};
        var bpm = op0(6); bpm.a = 1; bpm.d = 1; out.append(alloc, bpm) catch {};
        if (std.posix.getenv("RIVE_TRACE_DRAW") != null) std.debug.print("ARTPAINT obj={d} color={x}\n", .{ pi, color });
        var bdr = op0(8); bdr.style = if (c.type_key == 24) @as(i64, 0) else @as(i64, 1); bdr.color = color; bdr.join = -1; bdr.cap = -1; out.append(alloc, bdr) catch {};
        out.append(alloc, op0(7)) catch {};
    }
    // Layout-box backgrounds: a Fill parented to a LayoutComponent (409)
    // paints that box. rive renders these; without them a data-bound list is
    // invisible. component_list_1's green #18b900 is obj[57] Fill under
    // obj[45] LayoutComponent, not under a Shape, so no Shape pass sees it.
    for (r.objects, 0..) |lc, lci| {
        if (lc.type_key != 409) continue;
        if (owningArtboard(r, lci) != abIdx) continue;
        var lw = propF(lc.props, 7, 0);
        var lh = propF(lc.props, 8, 0);
        var rtl: f32 = 0; var rtr: f32 = 0; var rbr: f32 = 0; var rbl: f32 = 0;
        // LayoutSizingStyle width/height units on the component's style (a 420
        // child). 3 = fill the parent box, which is how a row background ends
        // up 200x50 instead of its base 178x55.
        for (r.objects) |st| {
            if (st.type_key != 420) continue;
            if (st.parent_obj != @as(i64, @intCast(lci))) continue;
            const wu = propU(st.props, 607, 0);
            const hu = propU(st.props, 608, 0);
            if (wu == 3 or hu == 3) {
                const p = lc.parent_obj;
                if (p >= 0 and @as(usize, @intCast(p)) < r.objects.len) {
                    const po = &r.objects[@intCast(p)];
                    var pw = propF(po.props, 7, 0);
                    var ph = propF(po.props, 8, 0);
                    // An intrinsically-sized artboard's layout box is its
                    // content bounds + padding, not the declared w/h —
                    // Item's green row must hug the "0" glyph, not fill 91x52.
                    if (po.type_key == 1) {
                        const es = artboardIntrinsicSize(r, @intCast(p), pw, ph);
                        pw = es.w; ph = es.h;
                    }
                    if (wu == 3 and pw > 0) lw = pw;
                    if (hu == 3 and ph > 0) lh = ph;
                }
            }
            // Corner radii on the same style (640-643, TL-inherit like the
            // artboard backdrop path). Item obj85 carries TL=8.
            rtl = propF(st.props, 640, 0);
            rtr = propF(st.props, 641, rtl);
            rbl = propF(st.props, 642, rtl);
            rbr = propF(st.props, 643, rtl);
            break;
        }
        if (lw > 0 and lh > 0) {
            // Layout-managed boxes take their position from the layout
            // solve (absolute/fill/align), not Node.x/y — clv Overlay
            // sits at y=360 via positionBottom, Viewport clips at (100,100).
            const lwm = effectiveWorldRaw(r, lci);
            const lx = lwm[4];
            const ly = lwm[5];
            for (r.objects, 0..) |c, pi| {
                const noLstroke = std.posix.getenv("RIVE_NO_LSTROKE") != null and c.type_key == 24;
                if (c.type_key != 20 and (c.type_key != 24 or noLstroke)) continue;
                if (c.parent_obj != @as(i64, @intCast(lci))) continue;
                var lcolor: u32 = 0;
                for (r.objects) |*g| {
                    if (g.parent_obj == @as(i64, @intCast(pi)) and g.type_key == 18) lcolor = propColorAnimOr(r, g, 37, cf, 0xFF747474);
                }
                if (((lcolor >> 24) & 0xFF) == 0) continue;
                // Rounded-rect when the component's style carries corner
                // radii (Item obj85 TL=8). Radii clamp to half the smaller
                // side; a zero corner degrades to a plain line.
                const rmax = @min(lw, lh) * 0.5;
                const ctl = @min(rtl, rmax); const ctr = @min(rtr, rmax);
                const cbr = @min(rbr, rmax); const cbl = @min(rbl, rmax);
                const k: f32 = 0.5522847498;
                out.append(alloc, op0(0)) catch {};
                if (ctl + ctr + cbr + cbl > 0) {
                    var m0 = op0(1); m0.x1 = @floatCast(ctl); m0.y1 = 0; out.append(alloc, m0) catch {};
                    var t1 = op0(2); t1.x1 = @floatCast(lw - ctr); t1.y1 = 0; out.append(alloc, t1) catch {};
                    if (ctr > 0) {
                        var c1 = op0(4); c1.x1 = @floatCast(lw - ctr + ctr * k); c1.y1 = 0; c1.x2 = @floatCast(lw); c1.y2 = @floatCast(ctr * (1 - k)); c1.x3 = @floatCast(lw); c1.y3 = @floatCast(ctr); out.append(alloc, c1) catch {};
                    } else { var l1 = op0(2); l1.x1 = @floatCast(lw); l1.y1 = 0; out.append(alloc, l1) catch {}; }
                    var t2 = op0(2); t2.x1 = @floatCast(lw); t2.y1 = @floatCast(lh - cbr); out.append(alloc, t2) catch {};
                    if (cbr > 0) {
                        var c2 = op0(4); c2.x1 = @floatCast(lw); c2.y1 = @floatCast(lh - cbr + cbr * k); c2.x2 = @floatCast(lw - cbr + cbr * k); c2.y2 = @floatCast(lh); c2.x3 = @floatCast(lw - cbr); c2.y3 = @floatCast(lh); out.append(alloc, c2) catch {};
                    } else { var l2 = op0(2); l2.x1 = @floatCast(lw); l2.y1 = @floatCast(lh); out.append(alloc, l2) catch {}; }
                    var t3 = op0(2); t3.x1 = @floatCast(cbl); t3.y1 = @floatCast(lh); out.append(alloc, t3) catch {};
                    if (cbl > 0) {
                        var c3 = op0(4); c3.x1 = @floatCast(cbl - cbl * k); c3.y1 = @floatCast(lh); c3.x2 = 0; c3.y2 = @floatCast(lh - cbl + cbl * k); c3.x3 = 0; c3.y3 = @floatCast(lh - cbl); out.append(alloc, c3) catch {};
                    } else { var l3 = op0(2); l3.x1 = 0; l3.y1 = @floatCast(lh); out.append(alloc, l3) catch {}; }
                    var t4 = op0(2); t4.x1 = 0; t4.y1 = @floatCast(ctl); out.append(alloc, t4) catch {};
                    if (ctl > 0) {
                        var c4 = op0(4); c4.x1 = 0; c4.y1 = @floatCast(ctl - ctl * k); c4.x2 = @floatCast(ctl - ctl * k); c4.y2 = 0; c4.x3 = @floatCast(ctl); c4.y3 = 0; out.append(alloc, c4) catch {};
                    } else { var l4 = op0(2); l4.x1 = 0; l4.y1 = 0; out.append(alloc, l4) catch {}; }
                } else {
                    var b0 = op0(1); b0.x1 = 0; b0.y1 = 0; out.append(alloc, b0) catch {};
                    var b1 = op0(2); b1.x1 = @floatCast(lw); b1.y1 = 0; out.append(alloc, b1) catch {};
                    var b2 = op0(2); b2.x1 = @floatCast(lw); b2.y1 = @floatCast(lh); out.append(alloc, b2) catch {};
                    var b3 = op0(2); b3.x1 = 0; b3.y1 = @floatCast(lh); out.append(alloc, b3) catch {};
                }
                out.append(alloc, op0(5)) catch {};
                var bpm = op0(6); bpm.a = 1; bpm.b = 0; bpm.c = 0; bpm.d = 1; bpm.e = @floatCast(lx); bpm.g = @floatCast(ly); out.append(alloc, bpm) catch {};
                const isStroke = c.type_key == 24;
                if (std.posix.getenv("RIVE_TRACE_DRAW") != null) std.debug.print("LAYPAINT obj={d} color={x}\n", .{ pi, lcolor });
                var bdr = op0(8); bdr.style = if (isStroke) @as(i64, 0) else @as(i64, 1); bdr.color = lcolor; bdr.thick = if (isStroke) propF(c.props, 47, 1) else 0; bdr.join = if (isStroke) propU(c.props, 49, 999) else @as(i64, -1); bdr.cap = if (isStroke) propU(c.props, 48, 999) else @as(i64, -1);
                if (isStroke) { const dd = dashOf(r, pi); if (dd.len > 0) { bdr.dash = dd.len; bdr.dashOff = dd.off; } }
                out.append(alloc, bdr) catch {};
                out.append(alloc, op0(7)) catch {};
            }
        }
    }
    // Embedded images (type 100): FileAssetContents bytes -> kind-11 op;
    // probe decodes via image.load.data + draws at the image rect.
    for (r.objects, 0..) |im, ii| {
        if (im.type_key != 100) continue;
        if (owningArtboard(r, ii) != abIdx) continue;
        var blob: ?[]const u8 = null;
        for (r.objects, 0..) |fc, fi| {
            if (fc.type_key != 106) continue;
            if (blob == null) {
                if (propByKey(fc.props, 212)) |v| {
                    switch (v) {
                        .bytes => |bb| blob = bb,
                        else => {},
                    }
                }
            }
            _ = fi;
        }
        const bytes = blob orelse { if (tracing()) std.debug.print("imgemit: no blob for obj {d}\n", .{ii}); continue; };
        if (tracing()) std.debug.print("imgemit: obj {d} blob {d}B\n", .{ ii, bytes.len });
        imgBlobs.append(alloc, bytes) catch {};
        const bidx: i64 = @intCast(imgBlobs.items.len - 1);
        out.append(alloc, op0(6)) catch {};
        var im1 = op0(11); im1.x1 = @as(f64, @floatFromInt(bidx));
        out.append(alloc, im1) catch {};
        out.append(alloc, op0(7)) catch {};
    }
    // ForegroundLayoutDrawable(513) draws a rect from its parent LayoutComponent
    // box, painted black. Layout solving is not implemented, so the box is the
    // parent's stored width/height — enough for the chart artboards' bars.
        const noFld = std.posix.getenv("RIVE_NO_FLD") != null;
        for (r.objects, 0..) |*fo, fi| {
            if (noFld) break;
            if (fo.type_key != 513) continue;
            if (owningArtboard(r, fi) != abIdx) continue;
            const pl = &r.objects[@intCast(fo.parent_obj)];
            const fw = propF(pl.props, 7, 0);
            const fh = propF(pl.props, 8, 0);
            if (fw <= 0 or fh <= 0) continue;
            // Same ancestor-opacity rule the shapes use: a hidden subtree draws
            // nothing. Without it the pass overshoots (LineBars +6).
            var faop: f32 = 1;
            var fanc: i64 = fo.parent_obj;
            var fhop: usize = 0;
            while (fanc >= 0 and fhop < 64) : (fhop += 1) {
                const fao = &r.objects[@intCast(fanc)];
                if (fao.type_key == 1) break;
                faop *= propF(fao.props, 18, 1);
                if (faop <= 0) break;
                fanc = fao.parent_obj;
            }
            if (faop <= 0) {
                if (std.posix.getenv("RIVE_TRACE_SKIP") != null) std.debug.print("SKIP fld={d} why=ancestor_opacity\n", .{fi});
                continue;
            }
            // No paint source, nothing to draw: the FLD's fill is a *sibling*
            // Fill under the same LayoutComponent. LineBars' six FLDs have none
            // and the reference draws none of them (that was the +6 overshoot).
            var fpaint = false;
            for (r.objects) |*fpb| {
                if (fpb.parent_obj != fo.parent_obj) continue;
                if (fpb.type_key == 20 or fpb.type_key == 24) { fpaint = true; break; }
            }
            if (!fpaint) {
                if (std.posix.getenv("RIVE_TRACE_SKIP") != null) std.debug.print("SKIP fld={d} why=no_paint\n", .{fi});
                continue;
            }
            const fwm = effectiveWorld(r, fi, frame);
            out.append(alloc, op0(0)) catch {};
            var f0 = op0(1); f0.x1 = 0; f0.y1 = 0; out.append(alloc, f0) catch {};
            var f1 = op0(2); f1.x1 = @floatCast(fw); f1.y1 = 0; out.append(alloc, f1) catch {};
            var f2 = op0(2); f2.x1 = @floatCast(fw); f2.y1 = @floatCast(fh); out.append(alloc, f2) catch {};
            var f3 = op0(2); f3.x1 = 0; f3.y1 = @floatCast(fh); out.append(alloc, f3) catch {};
            out.append(alloc, op0(5)) catch {};
            var fm = op0(6); fm.a = fwm[0]; fm.b = fwm[1]; fm.c = fwm[2]; fm.d = fwm[3]; fm.e = fwm[4]; fm.g = fwm[5]; out.append(alloc, fm) catch {};
            if (std.posix.getenv("RIVE_TRACE_DRAW") != null) std.debug.print("FLD obj={d}\n", .{fi});
            var fd = op0(8); fd.style = 1; fd.color = 0xFF000000; fd.join = -1; fd.cap = -1; fd.eo = 0; out.append(alloc, fd) catch {};
            out.append(alloc, op0(7)) catch {};
        }

    for (r.objects, 0..) |so, si| {
        if (so.type_key != 3) continue;
        if (owningArtboard(r, si) != abIdx) continue;
        if (std.posix.getenv("RIVE_SKIP_TGT") != null and (si == 27 or si == 30)) continue;
        var pathVs = std.ArrayList(PV).empty;
        var verbs = std.ArrayList(u8).empty;
        var pts = std.ArrayList(V2).empty;
        defer pathVs.deinit(alloc); defer verbs.deinit(alloc); defer pts.deinit(alloc);
        var closed = false; var pathFR: i64 = -1;
        for (r.objects, 0..) |*c, ci| {
            if (c.parent_obj != @as(i64, @intCast(si))) continue;
            if (propU(c.props, 128, @as(i64, -1)) >= 0) pathFR = propU(c.props, 128, 0);
            const cm = pathSpaceMat(r, ci, si, if (frame >= 0) frame else -1);
            const pvStart = pathVs.items.len;
            if (isVertexType(c.type_key)) {
                pathVs.append(alloc, fileVert(r, c, if (frame >= 0) frame else -1)) catch {};
            } else if (c.type_key == 16) {
                for (r.objects) |*gv| {
                    if (gv.parent_obj == @as(i64, @intCast(ci)) and isVertexType(gv.type_key)) {
                        pathVs.append(alloc, fileVert(r, gv, if (frame >= 0) frame else -1)) catch {};
                    }
                }
            } else if (synthParametric(r, c, &pathVs, alloc, if (frame >= 0) frame else -1)) {
                closed = true;
            }
            for (pathVs.items[pvStart..]) |*pv| xformPV(cm, pv);
        }
        if (pathVs.items.len < 2) continue;
        if (tracing()) std.debug.print("shape si={d} slot={d} ab={d} pts={d} closed={}\n", .{ si, so.slot, owningArtboard(r, si), pathVs.items.len, closed });
        buildPath(pathVs.items, closed, &verbs, &pts, alloc);
        if (verbs.items.len == 0) continue;
        const w = effectiveWorld(r, si, frame);
        // ClippingShape (type 42) child -> clip this shape's draws to the
        // SOURCE shape's geometry (sourceId = source shape's slot).
        // clip_tests: Shape47 rect clipped by Shape43 ellipse.
        var clipPushed = false;
        var clipDepth: usize = 0;
        for (r.objects, 0..) |*cc, ci| {
            if (cc.type_key != 42) continue;
            // ClippingShape clips every Drawable descendant-or-self of
            // its parent (container_component forAll includes self):
            // CS child-of-Shape clips that shape; CS child-of-Node clips
            // the node's whole drawable subtree. Ancestor test covers both.
            var anc: i64 = @intCast(si); // self included: CS child-of-shape clips that shape
            var isClipped = false;
            var ad: usize = 0;
            while (ad < 32) : (ad += 1) {
                if (anc == cc.parent_obj) { isClipped = true; break; }
                if (anc < 0) break;
                anc = r.objects[@intCast(anc)].parent_obj;
            }
            if (!isClipped) continue;
            const srcId = propU(cc.props, 92, -1);
            if (std.posix.getenv("RIVE_TRACE_CS") != null) std.debug.print("cs cand cc={d} srcId={d}\n", .{ ci, srcId });
            if (srcId < 0) continue;
            var srcIdx: usize = r.objects.len;
            for (r.objects, 0..) |*so2, sj| {
                if (so2.slot == srcId and owningArtboard(r, sj) == abIdx) { srcIdx = sj; break; }
            }
            if (std.posix.getenv("RIVE_TRACE_CS") != null) std.debug.print("cs src cc found={} srcIdx={d}\n", .{ srcIdx != r.objects.len, srcIdx });
            if (srcIdx == r.objects.len) continue;
            var sVerbs = std.ArrayList(u8).empty;
            var sPts = std.ArrayList(V2).empty;
            defer sVerbs.deinit(alloc); defer sPts.deinit(alloc);
            // Per-child contours: each path object is its own contour —
            // buildPath emits a move verb per call, so concatenating
            // per-child outputs yields move-separated subpaths (the
            // joined-single-contour form broke clip.push.path masks).
            for (r.objects, 0..) |*sc, sci| {
                // Transitive: any descendant of the source node (or the
                // source itself) can carry clip contours — hunter_x CS
                // sources are Nodes/parametric shapes whose paths nest
                // deeper than one level. Skip objects nested inside an
                // intermediate type-16 contour (already counted there).
                if (sci != srcIdx) {
                    var reach = false;
                    var mid16 = false;
                    var hops: usize = 0;
                    var cur = sc.parent_obj;
                    while (hops < 32) : (hops += 1) {
                        if (cur < 0) break;
                        if (cur == @as(i64, @intCast(srcIdx))) { reach = true; break; }
                        if (r.objects[@intCast(cur)].type_key == 16) mid16 = true;
                        cur = r.objects[@intCast(cur)].parent_obj;
                    }
                    if (!reach or mid16) continue;
                }
                // pathFlags(128) bit0 = hidden contour — clip_tests
                // clipper's second ellipse (obj45, flags=1) must not
                // join the clip region; only the +150 half clips.
                if ((propU(sc.props, 128, 0) & 1) != 0) continue;
                var cVs = std.ArrayList(PV).empty;
                defer cVs.deinit(alloc);
                var cClosed = false;
                const scm2 = pathSpaceMat(r, sci, srcIdx, if (frame >= 0) frame else -1);
                if (isVertexType(sc.type_key)) {
                    cVs.append(alloc, fileVert(r, sc, if (frame >= 0) frame else -1)) catch {};
                } else if (sc.type_key == 16) {
                    for (r.objects) |*gv| {
                        if (gv.parent_obj == @as(i64, @intCast(sci)) and isVertexType(gv.type_key)) {
                            cVs.append(alloc, fileVert(r, gv, if (frame >= 0) frame else -1)) catch {};
                        }
                    }
                } else if (synthParametric(r, sc, &cVs, alloc, if (frame >= 0) frame else -1)) {
                    cClosed = true;
                }
                for (cVs.items) |*pv| xformPV(scm2, pv);
                if (cVs.items.len >= 2) buildPath(cVs.items, cClosed, &sVerbs, &sPts, alloc);
            }
            if (std.posix.getenv("RIVE_TRACE_CS") != null) std.debug.print("cs verbs={d}\n", .{sVerbs.items.len});
            if (sVerbs.items.len == 0) continue;
            const sw = effectiveWorld(r, srcIdx, frame);
            out.append(alloc, op0(0)) catch {};
            var svp: usize = 0;
            for (sVerbs.items) |v| {
                const np: usize = if (v == 0 or v == 1) 1 else if (v == 2 or v == 3) 2 else if (v == 4) 3 else 0;
                if (svp + np > sPts.items.len) break;
                var o = op0(if (v == 0) 1 else if (v == 1) 2 else if (v == 2 or v == 3) 3 else if (v == 4) 4 else 5);
                if (v == 0 or v == 1) { o.x1 = sPts.items[svp].x; o.y1 = sPts.items[svp].y; }
                if (v == 2 or v == 3) { o.x1 = sPts.items[svp].x; o.y1 = sPts.items[svp].y; o.x2 = sPts.items[svp + 1].x; o.y2 = sPts.items[svp + 1].y; }
                if (v == 4) { o.x1 = sPts.items[svp].x; o.y1 = sPts.items[svp].y; o.x2 = sPts.items[svp + 1].x; o.y2 = sPts.items[svp + 1].y; o.x3 = sPts.items[svp + 2].x; o.y3 = sPts.items[svp + 2].y; }
                out.append(alloc, o) catch {};
                svp += np;
            }
            var scm = op0(6); scm.a = sw[0]; scm.b = sw[1]; scm.c = sw[2]; scm.d = sw[3]; scm.e = sw[4]; scm.g = sw[5]; out.append(alloc, scm) catch {};
            var cp = op0(9); cp.eo = 0; out.append(alloc, cp) catch {};
            out.append(alloc, op0(7)) catch {};
            clipPushed = true;
            clipDepth += 1;
        }
        for (r.objects, 0..) |*c, pi| {
            if (c.parent_obj != @as(i64, @intCast(si))) continue;
            if (c.type_key != 20 and c.type_key != 24) continue;
            // isVisible(41): false/0 paints emit nothing — rive-cpp culls
            // them before raster (image-oracle overdraw fix).
            if (propByKey(c.props, 41)) |v| switch (v) {
                .boolean => |b| if (!b) continue,
                .dbl => |x| if (x == 0) continue,
                else => {},
            };
            var color: u32 = 0xFF747474;
            for (r.objects, 0..) |*g, gi| {
                if (g.type_key == 18 and g.parent_obj == @as(i64, @intCast(pi))) { color = propColorAnimOr(r, g, 37, cf, 0xFF747474); _ = gi; }
            // Gradient paints carry their paint as a shader, so the renderer's
            // recorded colour is black, not the SolidColor default. Until ops
            // can carry a shader (named gap), match the recorded colour: an
            // opaque black rather than the 0xFF747474 default.
            {
                var hasGrad = false;
                for (r.objects) |*gg| {
                    if (gg.parent_obj != @as(i64, @intCast(pi))) continue;
                    if (gg.type_key == 17 or gg.type_key == 22) { hasGrad = true; break; }
                }
                if (hasGrad and propByKey(c.props, 41) == null) color = 0xFF000000;
            }
            }
            // WorldTransformComponent.opacity(18) keyframes scale alpha;
            // opacity 0 = object hidden by SM — skip the draw entirely.
            const opSelf: f32 = if (frame >= 0 and hasKeyframedAb(r, abIdx, so.slot, 18)) keyframedValue(r, so.slot, 18, frame) else propF(so.props, 18, 1);
            // Ancestor opacity multiplies down the tree: rive-cpp hides a whole
            // subtree when a Node's opacity is 0 (car_widgets TIRE PRESSURE's
            // red band sits under a Node with opacity 0.000 and we drew it).
            var aop: f32 = 1;
            var anc: i64 = so.parent_obj;
            var ahop: usize = 0;
            while (anc >= 0 and ahop < 64) : (ahop += 1) {
                const ao = &r.objects[@intCast(anc)];
                if (ao.type_key == 1) break;
                aop *= propF(ao.props, 18, 1);
                if (aop <= 0) break;
                anc = ao.parent_obj;
            }
            if (aop <= 0) continue;
            const op: f32 = opSelf * aop;
            if (op <= 0 and std.posix.getenv("RIVE_NO_OPACITY_CULL") == null) {
                if (std.posix.getenv("RIVE_TRACE_SKIP") != null) std.debug.print("SKIP obj={d} paint={d} why=opacity self={d:.3} anc={d:.3} color={x} t={d:.1},{d:.1}\n", .{ si, pi, opSelf, aop, color, w[4], w[5] });
                continue;
            }
            const oa: u32 = @intFromFloat(@min(255, @as(f32, @floatFromInt((color >> 24) & 0xFF)) * op));
            color = (color & 0x00FFFFFF) | (oa << 24);
            // Alpha-0 paint: draw.path would rasterize invisible pixels —
            // skip the op stream entirely (same pixels, fewer ops).
            if (((color >> 24) & 0xFF) == 0) continue;
            if (tracing()) std.debug.print("  paint si={d} obj={d} type={d} color={x} frame={d}\n", .{ si, pi, c.type_key, color, frame });
            const isStroke = c.type_key == 24;
            const style: i64 = if (isStroke) 0 else 1;
            const thick = if (isStroke) propF(c.props, 47, 1) else 0;
            const join = if (isStroke) propU(c.props, 49, 999) else @as(i64, -1);
            const cap = if (isStroke) propU(c.props, 48, 999) else @as(i64, -1);
            const fr = if (pathFR >= 0) pathFR else if (isStroke) @as(i64, 2) else propU(c.props, 40, 0);
            out.append(alloc, op0(0)) catch {};
            var vp: usize = 0;
            for (verbs.items) |v| {
                const np: usize = if (v == 0 or v == 1) 1 else if (v == 2 or v == 3) 2 else if (v == 4) 3 else 0;
                if (vp + np > pts.items.len) {
                    // Silent truncation here is what hid the missing
                    // contours: the whole rest of the path (including close)
                    // vanished with no signal.
                    std.debug.print("collectArtboardOps: PATH TRUNCATED verb={d} vp={d} np={d} pts={d}\n", .{ v, vp, np, pts.items.len });
                    break;
                }
                var o = op0(if (v == 0) 1 else if (v == 1) 2 else if (v == 2 or v == 3) 3 else if (v == 4) 4 else 5);
                if (v == 0 or v == 1) { o.x1 = pts.items[vp].x; o.y1 = pts.items[vp].y; }
                if (v == 2 or v == 3) { o.x1 = pts.items[vp].x; o.y1 = pts.items[vp].y; o.x2 = pts.items[vp + 1].x; o.y2 = pts.items[vp + 1].y; }
                if (v == 4) { o.x1 = pts.items[vp].x; o.y1 = pts.items[vp].y; o.x2 = pts.items[vp + 1].x; o.y2 = pts.items[vp + 1].y; o.x3 = pts.items[vp + 2].x; o.y3 = pts.items[vp + 2].y; }
                out.append(alloc, o) catch {};
                vp += np;
            }
            var pm = op0(6); pm.a = w[0]; pm.b = w[1]; pm.c = w[2]; pm.d = w[3]; pm.e = w[4]; pm.g = w[5]; out.append(alloc, pm) catch {};
            if (std.posix.getenv("RIVE_TRACE_DRAW") != null) std.debug.print("DRAW obj={d} paint={d} style={d} color={x} m={d:.1},{d:.1},{d:.1} t={d:.1},{d:.1}\n", .{ si, pi, style, color, w[0], w[1], w[3], w[4], w[5] });
            var dr = op0(8); dr.style = style; dr.color = color; dr.thick = thick; dr.join = join; dr.cap = cap; dr.eo = if (fr == 1) 1 else 0;
            if (isStroke) { const dd = dashOf(r, pi); if (dd.len > 0) { dr.dash = dd.len; dr.dashOff = dd.off; } }
            out.append(alloc, dr) catch {};
            out.append(alloc, op0(7)) catch {};
        }
        for (0..clipDepth) |_| out.append(alloc, op0(10)) catch {};
    }
    // Text objects: glyph outlines via textDrawPath (same gather as emitOps).
    for (r.objects, 0..) |to, ti| {
        if (to.type_key != 134) continue;
        if (owningArtboard(r, ti) != abIdx) continue;
        var tverbs = std.ArrayList(u8).empty;
        var tpts = std.ArrayList(V2).empty;
        defer tverbs.deinit(alloc); defer tpts.deinit(alloc);
        var tcolor: u32 = 0xFF000000;
        var tfr: i64 = 2;
        if (!textDrawPath(r, ti, frame, alloc, &tverbs, &tpts, &tcolor, &tfr, -1)) continue;
        const w = effectiveWorld(r, ti, frame);
        out.append(alloc, op0(0)) catch {};
        var vp: usize = 0;
        for (tverbs.items) |v| {
            const np: usize = if (v == 0 or v == 1) 1 else if (v == 2 or v == 3) 2 else if (v == 4) 3 else 0;
            if (vp + np > tpts.items.len) break;
            var o = op0(if (v == 0) 1 else if (v == 1) 2 else if (v == 2 or v == 3) 3 else if (v == 4) 4 else 5);
            if (v == 0 or v == 1) { o.x1 = tpts.items[vp].x; o.y1 = tpts.items[vp].y; }
            if (v == 2 or v == 3) { o.x1 = tpts.items[vp].x; o.y1 = tpts.items[vp].y; o.x2 = tpts.items[vp + 1].x; o.y2 = tpts.items[vp + 1].y; }
            if (v == 4) { o.x1 = tpts.items[vp].x; o.y1 = tpts.items[vp].y; o.x2 = tpts.items[vp + 1].x; o.y2 = tpts.items[vp + 1].y; o.x3 = tpts.items[vp + 2].x; o.y3 = tpts.items[vp + 2].y; }
            out.append(alloc, o) catch {};
            vp += np;
        }
        var pm = op0(6); pm.a = w[0]; pm.b = w[1]; pm.c = w[2]; pm.d = w[3]; pm.e = w[4]; pm.g = w[5]; out.append(alloc, pm) catch {};
        if (std.posix.getenv("RIVE_TRACE_DRAW") != null) std.debug.print("TXT obj={d} color={x}\n", .{ ti, tcolor });
        var dr = op0(8); dr.style = 1; dr.color = tcolor; dr.join = -1; dr.cap = -1; dr.eo = if (tfr == 1) 1 else 0; out.append(alloc, dr) catch {};
        out.append(alloc, op0(7)) catch {};
    }
    if (clipOn) out.append(alloc, op0(10)) catch {};
    // subtree.
    const noNested = std.posix.getenv("RIVE_NO_NESTED") != null;
    for (r.objects, 0..) |no, ni| {
        if (noNested) break;
        if (no.type_key != 92 and no.type_key != 451 and no.type_key != 452) continue;
        if (std.posix.getenv("RIVE_TRACE_NEST") != null) std.debug.print("nest cand ni={d} type={d} owner={d} ab={d}\n", .{ ni, no.type_key, owningArtboard(r, ni), abIdx });
        if (owningArtboard(r, ni) != abIdx) continue;
        if (g_abDepth >= 8) continue;
        const aid = propU(no.props, 197, -1);
        if (std.posix.getenv("RIVE_TRACE_NEST") != null) std.debug.print("nest owned ni={d} aid={d}\n", .{ ni, aid });
        if (aid < 0) continue;
        var seen: i64 = 0;
        var target: i64 = -1;
        for (r.objects, 0..) |abo, abi| {
            if (abo.type_key != 1) continue;
            if (seen == aid) { target = @intCast(abi); break; }
            seen += 1;
        }
        if (std.posix.getenv("RIVE_TRACE_NEST") != null) std.debug.print("nest target ni={d} aid={d} -> {d}\n", .{ ni, aid, target });
        if (target < 0) continue;
        if (target == @as(i64, @intCast(abIdx))) continue; // self-reference guard
        var onPath = false;
        for (g_abStack[0..g_abStackLen]) |sa| { if (sa == @as(usize, @intCast(target))) { onPath = true; break; } }
        if (onPath) continue; // cycle: target already on expansion path
        const w = effectiveWorld(r, ni, frame);
        var so = op0(6); so.a = w[0]; so.b = w[1]; so.c = w[2]; so.d = w[3]; so.e = w[4]; so.g = w[5];
        out.append(alloc, so) catch {};
        const hostAnim = g_activeAnim;
        const hostFrom = g_blendFrom;
        const hostT = g_blendT;
        g_activeAnim = smActiveAnimIdx(r, @intCast(target), frame);
        g_abDepth += 1;
        if (g_abStackLen < g_abStack.len) { g_abStack[g_abStackLen] = @as(usize, @intCast(target)); g_abStackLen += 1; }
        collectArtboardOps(r, @intCast(target), frame, alloc, out);
        g_abStackLen -%= 1;
        g_abDepth -= 1;
        g_activeAnim = hostAnim;
        g_blendFrom = hostFrom;
        g_blendT = hostT;
        out.append(alloc, op0(7)) catch {};
    }
    g_scrubOverrides.items.len = scrubBase;
    return;
}


fn collectOps(r: *Riv, abIdx: usize, frame: i64, alloc: std.mem.Allocator) []OpRec {
    g_activeAnim = smActiveAnimIdx(r, abIdx, frame);
    if (std.posix.getenv("RIVE_TRACE_SM") != null) std.debug.print("sm ab={d} frame={d} activeAnim={d}\n", .{ abIdx, frame, g_activeAnim });
    g_abStackLen = 0;
    if (g_abStackLen < g_abStack.len) { g_abStack[g_abStackLen] = abIdx; g_abStackLen += 1; }
    var out = std.ArrayList(OpRec).empty;
    errdefer out.deinit(alloc);
    collectArtboardOps(r, abIdx, frame, alloc, &out);
    // Component-list rows: ArtboardComponentList(559) items(427) with a
    // ViewModel id -> embedded artboard (prop 583) renders at its own
    // layout transform — same composed pass as emitOps rows mode.
    for (r.objects, 0..) |lo, li| {
        if (lo.type_key != 559) continue;
        if (owningArtboard(r, li) != abIdx) continue;
        const items = listRowItems(r, li, alloc);
        defer alloc.free(items);
        // Scroll clip: nearest LayoutComponent(409) ancestor with
        // clip=true (prop 196) bounds the rows — cl1 ScrollView
        // 460x300 at origin clips rows 6-8 below y=300.
        var clipLc: i64 = -1;
        {
            var cp = lo.parent_obj;
            var cd: usize = 0;
            while (cp >= 0 and cd < 32) : (cd += 1) {
                const cpo = &r.objects[@intCast(cp)];
                if (cpo.type_key == 409) {
                    if (propByKey(cpo.props, 196)) |v| {
                        const on = switch (v) { .boolean => |b| b, .dbl => |x| x != 0, else => false };
                        if (on) { clipLc = cp; break; }
                    }
                }
                cp = cpo.parent_obj;
            }
        }
        if (clipLc >= 0) {
            const clo = &r.objects[@intCast(clipLc)];
            const cw = propF(clo.props, 7, 0);
            const ch = propF(clo.props, 8, 0);
            const cwm = effectiveWorldRaw(r, @intCast(clipLc));
            out.append(alloc, op0(0)) catch {};
            var q0 = op0(1); q0.x1 = 0; q0.y1 = 0; out.append(alloc, q0) catch {};
            var q1 = op0(2); q1.x1 = @floatCast(cw); q1.y1 = 0; out.append(alloc, q1) catch {};
            var q2 = op0(2); q2.x1 = @floatCast(cw); q2.y1 = @floatCast(ch); out.append(alloc, q2) catch {};
            var q3 = op0(2); q3.x1 = 0; q3.y1 = @floatCast(ch); out.append(alloc, q3) catch {};
            out.append(alloc, op0(5)) catch {};
            var qm = op0(6); qm.a = cwm[0]; qm.b = cwm[1]; qm.c = cwm[2]; qm.d = cwm[3]; qm.e = cwm[4]; qm.g = cwm[5]; out.append(alloc, qm) catch {};
            var qp = op0(9); qp.eo = 0; out.append(alloc, qp) catch {};
            out.append(alloc, op0(7)) catch {};
        }
        var rowIdx: usize = 0;
        for (items) |row| {
            if (row.vmId < 0) continue;
            g_rowVmid = row.vmId;
            g_rowInstOrd = row.instOrd;
            g_rowIdx = @intCast(rowIdx);
            g_cframe = frame;
            for (r.objects, 0..) |ao, ai2| {
                if (ao.type_key != 1) continue;
                if (propU(ao.props, 583, -1) == row.vmId) {
                    // Rows render at their BASE pose: a component list lays its
                    // items out but does not advance each item artboard's own
                    // LinearAnimation. Measured on
                    // component_list_default_state_machine (Row rect: base
                    // width 100, keyframed to 150): Rive draws 100x40 in the
                    // list, while passing the host frame through drew 150x40.
                    // Static (-1) reproduces the observed 100x40 exactly.
                    // Colors still animate via g_cframe (cl2 item fill).
                    const slot = listRowSlot(r, li, ai2, rowIdx, rowCountOf(items), frame);
                    var so = op0(6); so.a = slot[0]; so.b = slot[1]; so.c = slot[2]; so.d = slot[3]; so.e = slot[4]; so.g = slot[5];
                    out.append(alloc, so) catch {};
                    // Per-row SM scope: the embedded artboard's own state
                    // machine selects its active animation (cl2 Item rows
                    // keyframe their fill; host SM would scope them out).
                    const hostAnim = g_activeAnim;
                    const hostFrom = g_blendFrom;
                    const hostT = g_blendT;
                    g_activeAnim = smActiveAnimIdx(r, ai2, frame);
                    collectArtboardOps(r, ai2, -1, alloc, &out);
                    g_activeAnim = hostAnim;
                    g_blendFrom = hostFrom;
                    g_blendT = hostT;
                    out.append(alloc, op0(7)) catch {};
                }
            }
            rowIdx += 1;
            g_rowVmid = -1;
            g_rowInstOrd = -1;
            g_rowIdx = -1;
            g_cframe = -1;
        }
        if (clipLc >= 0) out.append(alloc, op0(10)) catch {};
    }
    // Nested artboard instances: NestedArtboard(92) / NestedArtboardLeaf(451) /
    // NestedArtboardLayout(452) compose a transform but were never expanded
    // into the target artboard's drawables — the whole subtree was invisible.
    // artboardId(197) is an INDEX into the file's artboard list (rive-cpp:
    // File::artboard(size_t index)), NOT a ViewModel id: matching on
    // 583/Artboard.viewModelId matches by coincidence and expands the wrong
    g_activeAnim = -1;
    g_blendFrom = -1;
    g_blendT = 0;
    return out.items;
}
~pub tor ops { r: *Riv<loaded>, ab: i64, frame: i64 }
! op OpRec
| done usize

~proc ops|zig {
    const recs = $mod.collectOps(r, @intCast(ab), frame, std.heap.page_allocator);
    var n: usize = 0;
    for (recs) |rec| {
        op(rec);
        n += 1;
    }
    return .{ .done = n };
}

// ---- tessellation: OpRec path -> flattened polygon -> triangle soup ----
// Backend-agnostic pure geometry (phase-4). Consumes the same verbs/pts
// the ops stream carries; emits Tri records a GPU backend draws directly.
// Fill rule honored by contour classification + hole bridging, not by
// leaving coverage to a stencil pass.

const Tri = struct { x1: f32, y1: f32, x2: f32, y2: f32, x3: f32, y3: f32 };

fn v2dist2(a: V2, b: V2) f32 { const dx = a.x - b.x; const dy = a.y - b.y; return dx * dx + dy * dy; }
fn v2mid(a: V2, b: V2) V2 { return .{ .x = (a.x + b.x) * 0.5, .y = (a.y + b.y) * 0.5 }; }
fn v2lerp(a: V2, b: V2, t: f32) V2 { return .{ .x = a.x + (b.x - a.x) * t, .y = a.y + (b.y - a.y) * t }; }

// de Casteljau cubic flatten: append points to `out` (excluding p0, which
// the caller already emitted). Flatness = max distance of controls from
// the chord, subdivided to `tol`.
fn flatCubic(p0: V2, p1: V2, p2: V2, p3: V2, tol: f32, depth: u32, out: *std.ArrayList(V2), alloc: std.mem.Allocator) void {
    if (depth > 16) { out.append(alloc, p3) catch {}; return; }
    // flatness: distance of p1,p2 from chord p0-p3
    const dx = p3.x - p0.x; const dy = p3.y - p0.y;
    const len2 = dx * dx + dy * dy;
    var d1: f32 = 0; var d2: f32 = 0;
    if (len2 > 0.0001) {
        d1 = @abs(dy * p1.x - dx * p1.y + p3.x * p0.y - p3.y * p0.x) / @sqrt(len2);
        d2 = @abs(dy * p2.x - dx * p2.y + p3.x * p0.y - p3.y * p0.x) / @sqrt(len2);
    } else {
        d1 = @sqrt(v2dist2(p0, p1)); d2 = @sqrt(v2dist2(p0, p2));
    }
    if (@max(d1, d2) <= tol) { out.append(alloc, p3) catch {}; return; }
    const p01 = v2mid(p0, p1); const p12 = v2mid(p1, p2); const p23 = v2mid(p2, p3);
    const p012 = v2mid(p01, p12); const p123 = v2mid(p12, p23);
    const pm = v2mid(p012, p123);
    flatCubic(p0, p01, p012, pm, tol, depth + 1, out, alloc);
    flatCubic(pm, p123, p23, p3, tol, depth + 1, out, alloc);
}

fn flatQuad(p0: V2, p1: V2, p2: V2, tol: f32, depth: u32, out: *std.ArrayList(V2), alloc: std.mem.Allocator) void {
    if (depth > 16) { out.append(alloc, p2) catch {}; return; }
    const dx = p2.x - p0.x; const dy = p2.y - p0.y;
    const len2 = dx * dx + dy * dy;
    var d1: f32 = 0;
    if (len2 > 0.0001) {
        d1 = @abs(dy * p1.x - dx * p1.y + p2.x * p0.y - p2.y * p0.x) / @sqrt(len2);
    } else {
        d1 = @sqrt(v2dist2(p0, p1));
    }
    if (d1 <= tol) { out.append(alloc, p2) catch {}; return; }
    const p01 = v2mid(p0, p1); const p12 = v2mid(p1, p2); const pm = v2mid(p01, p12);
    flatQuad(p0, p01, pm, tol, depth + 1, out, alloc);
    flatQuad(pm, p12, p2, tol, depth + 1, out, alloc);
}

// verbs/pts (path-stream convention: 0 move 1 line 2/3 quad 4 cubic 5 close)
// -> list of flattened contours (each a closed-or-open point ring).
fn flattenPath(verbs: []const u8, pts: []const V2, tol: f32, alloc: std.mem.Allocator) [][]V2 {
    var contours = std.ArrayList([]V2).empty;
    var cur = std.ArrayList(V2).empty;
    var vp: usize = 0;
    var curStart: V2 = .{ .x = 0, .y = 0 };
    var prev: V2 = .{ .x = 0, .y = 0 };
    var started = false;
    const npFor = struct {
        fn f(v: u8) usize { return if (v == 0 or v == 1) 1 else if (v == 2 or v == 3) 2 else if (v == 4) 3 else 0; }
    }.f;
    for (verbs) |v| {
        const np = npFor(v);
        if (vp + np > pts.len) break;
        switch (v) {
            0 => {
                if (started and cur.items.len > 2) contours.append(alloc, cur.toOwnedSlice(alloc) catch &.{} ) catch {};
                cur = std.ArrayList(V2).empty;
                curStart = pts[vp]; prev = pts[vp];
                cur.append(alloc, pts[vp]) catch {};
                started = true; vp += 1;
            },
            1 => {
                if (!started) { cur.append(alloc, pts[vp]) catch {}; curStart = pts[vp]; started = true; }
                prev = pts[vp]; cur.append(alloc, pts[vp]) catch {}; vp += 1;
            },
            2, 3 => {
                if (!started) { cur.append(alloc, pts[vp]) catch {}; curStart = pts[vp]; started = true; }
                flatQuad(prev, pts[vp], pts[vp + 1], tol, 0, &cur, alloc);
                prev = pts[vp + 1]; vp += 2;
            },
            4 => {
                if (!started) { cur.append(alloc, pts[vp]) catch {}; curStart = pts[vp]; started = true; }
                flatCubic(prev, pts[vp], pts[vp + 1], pts[vp + 2], tol, 0, &cur, alloc);
                prev = pts[vp + 2]; vp += 3;
            },
            5 => {
                if (started and cur.items.len > 2 and v2dist2(cur.items[cur.items.len - 1], curStart) > 0.01) {
                    cur.append(alloc, curStart) catch {};
                }
                if (started and cur.items.len > 2) contours.append(alloc, cur.toOwnedSlice(alloc) catch &.{}) catch {};
                cur = std.ArrayList(V2).empty; started = false; vp += 0;
            },
            else => { vp += np; },
        }
    }
    if (started and cur.items.len > 2) contours.append(alloc, cur.toOwnedSlice(alloc) catch &.{}) catch {};
    return contours.toOwnedSlice(alloc) catch &.{};
}

fn signedArea2(c: []const V2) f32 {
    var a: f32 = 0;
    for (c, 0..) |p, i| {
        const q = c[(i + 1) % c.len];
        a += p.x * q.y - q.x * p.y;
    }
    return a * 0.5;
}

fn pointInPoly(p: V2, c: []const V2) bool {
    var inside = false;
    var j: usize = c.len - 1;
    for (c, 0..) |pi, i| {
        const a = pi; const b = c[j];
        if ((a.y > p.y) != (b.y > p.y)) {
            const xint = (b.x - a.x) * (p.y - a.y) / (b.y - a.y) + a.x;
            if (p.x < xint) inside = !inside;
        }
        j = i;
    }
    return inside;
}

// winding number of point p wrt contour c (nonzero fill rule)
fn windingNum(p: V2, c: []const V2) i32 {
    var w: i32 = 0;
    var j: usize = c.len - 1;
    for (c, 0..) |pi, i| {
        const a = pi; const b = c[j];
        if (a.y <= p.y) {
            if (b.y > p.y and (b.x - a.x) * (p.y - a.y) - (p.x - a.x) * (b.y - a.y) > 0) w += 1;
        } else {
            if (b.y <= p.y and (b.x - a.x) * (p.y - a.y) - (p.x - a.x) * (b.y - a.y) < 0) w -= 1;
        }
        j = i;
    }
    return w;
}

// ear clipping: polygon (simple, may be self-touching) -> triangle indices.
// Returns list of Tri referencing contour points.
fn earClip(c: []const V2, alloc: std.mem.Allocator) []Tri {
    var tris = std.ArrayList(Tri).empty;
    defer tris.deinit(alloc);
    const n = c.len;
    if (n < 3) return tris.items;
    var idx = std.ArrayList(usize).empty;
    defer idx.deinit(alloc);
    // ensure CCW for ear test simplicity: reverse if signed area < 0
    var work = std.ArrayList(V2).empty;
    defer work.deinit(alloc);
    // dedupe consecutive + closing-duplicate points (flattened contours
    // can carry a zero-length edge that stalls ear clipping)
    var tmp = std.ArrayList(V2).empty;
    defer tmp.deinit(alloc);
    for (c) |p| {
        if (tmp.items.len > 0 and v2dist2(tmp.items[tmp.items.len - 1], p) < 0.0001) continue;
        tmp.append(alloc, p) catch {};
    }
    if (tmp.items.len > 1 and v2dist2(tmp.items[0], tmp.items[tmp.items.len - 1]) < 0.0001) {
        _ = tmp.items.len - 1;
        tmp.shrinkRetainingCapacity(tmp.items.len - 1);
    }
    if (signedArea2(tmp.items) < 0) {
        var i: usize = tmp.items.len;
        while (i > 0) { i -= 1; work.append(alloc, tmp.items[i]) catch {}; }
    } else {
        for (tmp.items) |p| work.append(alloc, p) catch {};
    }
    for (work.items, 0..) |_, i| idx.append(alloc, i) catch {};
    const wn = work.items.len;
    var guard: usize = 0;
    while (idx.items.len > 3 and guard < wn * wn * 4) : (guard += 1) {
        var clipped = false;
        for (idx.items, 0..) |_, ii| {
            const m = idx.items.len;
            const ia = idx.items[(ii + m - 1) % m];
            const ib = idx.items[ii];
            const ic = idx.items[(ii + 1) % m];
            const a = work.items[ia]; const b = work.items[ib]; const d = work.items[ic];
            // convex?
            const cross = (b.x - a.x) * (d.y - b.y) - (b.y - a.y) * (d.x - b.x);
            if (cross <= 0.000001) continue;
            // no other point inside triangle
            var empty = true;
            for (idx.items) |ok| {
                if (ok == ia or ok == ib or ok == ic) continue;
                const p = work.items[ok];
                const d1 = (b.x - a.x) * (p.y - a.y) - (b.y - a.y) * (p.x - a.x);
                const d2 = (d.x - b.x) * (p.y - b.y) - (d.y - b.y) * (p.x - b.x);
                const d3 = (a.x - d.x) * (p.y - d.y) - (a.y - d.y) * (p.x - d.x);
                if (d1 >= 0 and d2 >= 0 and d3 >= 0) { empty = false; break; }
            }
            if (!empty) continue;
            tris.append(alloc, .{ .x1 = a.x, .y1 = a.y, .x2 = b.x, .y2 = b.y, .x3 = d.x, .y3 = d.y }) catch {};
            _ = idx.orderedRemove(ii);
            clipped = true;
            break;
        }
        if (!clipped) break; // degenerate remainder — bail rather than loop
    }
    if (idx.items.len == 3) {
        const a = work.items[idx.items[0]]; const b = work.items[idx.items[1]]; const d = work.items[idx.items[2]];
        tris.append(alloc, .{ .x1 = a.x, .y1 = a.y, .x2 = b.x, .y2 = b.y, .x3 = d.x, .y3 = d.y }) catch {};
    }
    return tris.toOwnedSlice(alloc) catch &.{};
}

// Bridge a hole contour into its parent outer contour: splice the hole
// (reversed) into the outer ring at the closest visible vertex. Returns
// merged ring, or null if bridging fails (caller falls back to treating
// contours independently — named gap for pathological cases).
fn bridgeHole(outer: []const V2, hole: []const V2, alloc: std.mem.Allocator) ?[]V2 {
    // find hole vertex with max x (rightmost)
    var hi: usize = 0;
    for (hole, 0..) |p, i| { if (p.x > hole[hi].x) hi = i; }
    const hp = hole[hi];
    // find outer edge crossing the horizontal ray right of hp
    var bestT: f32 = 1e30; var bestI: usize = 0;
    for (outer, 0..) |a, i| {
        const b = outer[(i + 1) % outer.len];
        if ((a.y > hp.y) == (b.y > hp.y)) continue;
        const t = (hp.y - a.y) / (b.y - a.y);
        const xint = a.x + (b.x - a.x) * t;
        if (xint > hp.x and xint - hp.x < bestT) { bestT = xint - hp.x; bestI = i; }
    }
    if (bestT > 1e29) return null;
    // merged: outer[0..=bestI] + hole reversed from hi + outer[bestI+1..]
    var merged = std.ArrayList(V2).empty;
    defer merged.deinit(alloc);
    for (outer[0 .. bestI + 1]) |p| merged.append(alloc, p) catch {};
    // hole vertices in reverse winding starting at hi
    var k: usize = 0;
    while (k < hole.len) : (k += 1) {
        const idx = (hi + hole.len - k) % hole.len;
        merged.append(alloc, hole[idx]) catch {};
    }
    for (outer[bestI + 1 ..]) |p| merged.append(alloc, p) catch {};
    return merged.toOwnedSlice(alloc) catch null;
}

// contours + fill rule -> triangle soup.
// eo=1 even-odd, eo=0 nonzero winding. Holes bridged into parents.
fn tessellate(verbs: []const u8, pts: []const V2, eo: i64, tol: f32, alloc: std.mem.Allocator) []Tri {
    const contours = flattenPath(verbs, pts, tol, alloc);
    defer { for (contours) |c| alloc.free(c); }
    var tris = std.ArrayList(Tri).empty;
    defer tris.deinit(alloc);
    if (contours.len == 0) return tris.toOwnedSlice(alloc) catch &.{};
    if (contours.len == 1) return earClip(contours[0], alloc);
    // classify: compute depth of each contour inside others
    var depth = std.ArrayList(i32).empty;
    defer depth.deinit(alloc);
    var wind = std.ArrayList(i32).empty;
    defer wind.deinit(alloc);
    for (contours, 0..) |c, i| {
        // sample midpoint of first edge for containment tests
        const p = c[0];
        var d: i32 = 0; var w: i32 = 0;
        for (contours, 0..) |o, j| {
            if (j == i) continue;
            // skip degenerate
            if (o.len < 3) continue;
            if (eo == 1) {
                if (pointInPoly(p, o)) d += 1;
            } else {
                w += windingNum(p, o);
            }
        }
        depth.append(alloc, d) catch {}; wind.append(alloc, w) catch {};
    }
    // group: outers (depth 0 / wind 0) own holes (depth>0 odd / wind!=0)
    // simple v1: bridge every non-outer contour into the outer that
    // contains it (first match), then ear-clip each merged ring.
    var used = std.ArrayList(bool).empty;
    defer used.deinit(alloc);
    for (contours) |_| used.append(alloc, false) catch {};
    for (contours, 0..) |c, i| {
        if (used.items[i]) continue;
        const isOuter = if (eo == 1) @rem(depth.items[i], @as(i32, 2)) == 0 else wind.items[i] == 0;
        if (!isOuter) continue;
        var ring = c;
        var ringOwned: ?[]V2 = null;
        defer if (ringOwned) |r| alloc.free(r);
        // absorb holes contained in this outer
        for (contours, 0..) |h, j| {
            if (j == i or used.items[j]) continue;
            const hOuter = if (eo == 1) @rem(depth.items[j], @as(i32, 2)) == 1 else wind.items[j] != 0;
            if (!hOuter) continue;
            // is h inside ring? test hole's first point against ORIGINAL outer c
            if (!pointInPoly(h[0], c)) continue;
            if (bridgeHole(ring, h, alloc)) |merged| {
                if (ringOwned) |r| alloc.free(r);
                ringOwned = merged; ring = merged; used.items[j] = true;
            }
        }
        const ct = earClip(ring, alloc);
        for (ct) |t| tris.append(alloc, t) catch {};
        used.items[i] = true;
    }
    // leftover contours (unbridgeable / nested weirdness): emit independently
    for (contours, 0..) |c, i| {
        if (used.items[i]) continue;
        const ct = earClip(c, alloc);
        for (ct) |t| tris.append(alloc, t) catch {};
    }
    return tris.toOwnedSlice(alloc) catch &.{};
}

~pub tor tessdump { r: *Riv<loaded>, ab: i64, frame: i64 }
~proc tessdump|zig {
    const alloc = std.heap.page_allocator;
    const recs = $mod.collectOps(r, @intCast(ab), frame, alloc);
    var verbs = std.ArrayList(u8).empty;
    var pts = std.ArrayList(V2).empty;
    defer verbs.deinit(alloc); defer pts.deinit(alloc);
    for (recs) |rec| {
        switch (rec.kind) {
            1, 2, 3, 4, 5 => {
                const np: usize = if (rec.kind == 1 or rec.kind == 2) 1 else if (rec.kind == 3) 2 else if (rec.kind == 4) 3 else 0;
                const base: u8 = if (rec.kind == 1) 0 else if (rec.kind == 2) 1 else if (rec.kind == 3) 2 else if (rec.kind == 4) 4 else 5;
                verbs.append(alloc, @intCast(base)) catch {};
                for (0..np) |k| {
                    const xs = if (k == 0) rec.x1 else if (k == 1) rec.x2 else rec.x3;
                    const ys = if (k == 0) rec.y1 else if (k == 1) rec.y2 else rec.y3;
                    pts.append(alloc, .{ .x = @floatCast(xs), .y = @floatCast(ys) }) catch {};
                }
            },
            8 => {
                if (rec.style == 1 and verbs.items.len > 0) {
                    const tris = tessellate(verbs.items, pts.items, rec.eo, 0.25, alloc);
                    std.debug.print("DRAW style={d} eo={d} tris={d}\n", .{ rec.style, rec.eo, tris.len });
                    for (tris) |t| {
                        std.debug.print("TRI {d:.4} {d:.4} {d:.4} {d:.4} {d:.4} {d:.4}\n", .{ t.x1, t.y1, t.x2, t.y2, t.x3, t.y3 });
                    }
                }
                verbs.clearRetainingCapacity(); pts.clearRetainingCapacity();
            },
            9, 10 => { verbs.clearRetainingCapacity(); pts.clearRetainingCapacity(); },
            else => {},
        }
    }
}

// ---- stroke expansion: path + thick/join/cap -> outline ring -> tessellate ----
// join: 0=miter 1=round 2=bevel; cap: 0=butt 1=round 2=square (canvas enum).
// Produces a closed outline contour fed through the same earClip path
// as fills — stroke coverage becomes ordinary polygon fill on GPU.

fn v2perp(d: V2) V2 { return .{ .x = -d.y, .y = d.x }; }
fn v2unit(d: V2) V2 {
    const l = @sqrt(d.x * d.x + d.y * d.y);
    if (l < 0.000001) return .{ .x = 0, .y = 0 };
    return .{ .x = d.x / l, .y = d.y / l };
}
fn v2scaleV(a: V2, s: f32) V2 { return .{ .x = a.x * s, .y = a.y * s }; }
fn v2addV(a: V2, b: V2) V2 { return .{ .x = a.x + b.x, .y = a.y + b.y }; }

// arc of `n` segments from angle a0 to a1 around center c, radius r
fn arcPts(c: V2, r: f32, a0: f32, a1: f32, n: u32, out: *std.ArrayList(V2), alloc: std.mem.Allocator) void {
    var k: u32 = 1;
    while (k < n) : (k += 1) {
        const a = a0 + (a1 - a0) * @as(f32, @floatFromInt(k)) / @as(f32, @floatFromInt(n));
        out.append(alloc, .{ .x = c.x + @cos(a) * r, .y = c.y + @sin(a) * r }) catch {};
    }
}

fn capRun(center: V2, from: V2, to: V2, r: f32, capKind: i64, alloc: std.mem.Allocator, dst: *std.ArrayList(V2)) void {
            const a0 = std.math.atan2(from.y - center.y, from.x - center.x);
            var a1 = std.math.atan2(to.y - center.y, to.x - center.x);
            // choose sweep direction matching stroke side
            if (a1 < a0) a1 += 6.2831853;
            switch (capKind) {
                1 => arcPts(center, r, a0, a1, 8, dst, alloc), // round
                2 => { // square: extend endpoints outward along cap tangent
                    const dx = to.x - from.x; const dy = to.y - from.y;
                    const l = @sqrt(dx * dx + dy * dy);
                    if (l > 0.0001) {
                        const ux = dx / l; const uy = dy / l;
                        dst.append(alloc, .{ .x = to.x + ux * r, .y = to.y + uy * r }) catch {};
                        dst.append(alloc, .{ .x = from.x + ux * r, .y = from.y + uy * r }) catch {};
                    } else { dst.append(alloc, to) catch {}; }
                },
                else => { dst.append(alloc, to) catch {}; }, // butt
            }
        }
    

// stroke one flattened contour (open or closed ring) -> outline ring.
// Returns allocated []V2 suitable as an earClip contour.
fn strokeContour(ptsIn: []const V2, thick: f32, join: i64, cap: i64, closedIn: bool, alloc: std.mem.Allocator) ?[]V2 {
    const n = ptsIn.len;
    if (n < 2 or thick <= 0) return null;
    const half = thick * 0.5;
    const closed = closedIn or v2dist2(ptsIn[0], ptsIn[n - 1]) < 0.01;
    const m = if (closed) n - 1 else n; // distinct vertices
    if (m < 2) return null;
    // per-segment normals; joins expand each interior vertex per style
    var segN = std.ArrayList(V2).empty;
    defer segN.deinit(alloc);
    const segCount = if (closed) m else m - 1;
    for (0..segCount) |i| {
        const a = ptsIn[i]; const b = ptsIn[(i + 1) % m];
        segN.append(alloc, v2perp(v2unit(v2sub(b, a)))) catch {};
    }
    // build left/right offset polylines with join treatment at each vertex.
    // leftPts[k] corresponds to offset point on segment k's start side;
    // interior vertices may contribute multiple points (join geometry).
    var left = std.ArrayList(V2).empty;
    var right = std.ArrayList(V2).empty;
    defer left.deinit(alloc); defer right.deinit(alloc);
    const miterLimit: f32 = 4.0;
    // emit join points at vertex i between seg (i-1) and seg i normals
    const joinAt = struct {
        fn f(p: V2, nPrev: V2, nNext: V2, hh: f32, joinKind: i64, allocJ: std.mem.Allocator, lp: *std.ArrayList(V2), rp: *std.ArrayList(V2)) void {
            const lpEnd: V2 = .{ .x = p.x + nPrev.x * hh, .y = p.y + nPrev.y * hh };
            const lpStart: V2 = .{ .x = p.x + nNext.x * hh, .y = p.y + nNext.y * hh };
            const rpEnd: V2 = .{ .x = p.x - nPrev.x * hh, .y = p.y - nPrev.y * hh };
            const rpStart: V2 = .{ .x = p.x - nNext.x * hh, .y = p.y - nNext.y * hh };
            switch (joinKind) {
                0 => { // miter: intersect offset lines, clamp at miterLimit*thick
                    // solve p + nPrev*h + t*dPrev = p + nNext*h + s*dNext
                    const dPrev = v2perp(nPrev); const dNext = v2perp(nNext);
                    const den = dPrev.x * (-dNext.y) - dPrev.y * (-dNext.x);
                    var mx = lpEnd.x; var my = lpEnd.y; var beveled = false;
                    if (@abs(den) > 0.000001) {
                        const rx = lpStart.x - lpEnd.x; const ry = lpStart.y - lpEnd.y;
                        const t = (rx * (-dNext.y) - ry * (-dNext.x)) / den;
                        mx = lpEnd.x + dPrev.x * t; my = lpEnd.y + dPrev.y * t;
                        const dl = @sqrt((mx - p.x) * (mx - p.x) + (my - p.y) * (my - p.y));
                        if (dl > hh * miterLimit) beveled = true;
                    } else { beveled = true; }
                    if (beveled) {
                        lp.append(allocJ, lpEnd) catch {}; lp.append(allocJ, lpStart) catch {};
                        rp.append(allocJ, rpEnd) catch {}; rp.append(allocJ, rpStart) catch {};
                    } else {
                        const mp: V2 = .{ .x = mx, .y = my };
                        const mq: V2 = .{ .x = 2.0 * p.x - mx, .y = 2.0 * p.y - my };
                        lp.append(allocJ, mp) catch {}; rp.append(allocJ, mq) catch {};
                    }
                },
                1 => { // round: arc around p from prev-offset to next-offset
                    const a0 = std.math.atan2(lpEnd.y - p.y, lpEnd.x - p.x);
                    var a1 = std.math.atan2(lpStart.y - p.y, lpStart.x - p.x);
                    if (a1 < a0) a1 += 6.2831853;
                    arcPts(p ,hh, a0, a1, 6, lp, allocJ);
                    lp.append(allocJ, lpStart) catch {};
                    const b0 = std.math.atan2(rpEnd.y - p.y, rpEnd.x - p.x);
                    var b1 = std.math.atan2(rpStart.y - p.y, rpStart.x - p.x);
                    if (b1 < b0) b1 += 6.2831853;
                    arcPts(p ,hh, b0, b1, 6, rp, allocJ);
                    rp.append(allocJ, rpStart) catch {};
                },
                else => { // bevel: both offset endpoints
                    lp.append(allocJ, lpEnd) catch {}; lp.append(allocJ, lpStart) catch {};
                    rp.append(allocJ, rpEnd) catch {}; rp.append(allocJ, rpStart) catch {};
                },
            }
        }
    }.f;
    // walk vertices; at each interior vertex emit the join between the
    // incoming and outgoing segment offsets.
    const vcount = if (closed) m else m;
    for (0..vcount) |i| {
        const isInterior = closed or (i > 0 and i < m - 1);
        const p = ptsIn[i % m];
        if (!isInterior) {
            // endpoint: single averaged offset (cap handles the end)
            const si = if (i < segCount) i else segCount - 1;
            const nv = segN.items[si];
            left.append(alloc, .{ .x = p.x + nv.x * half, .y = p.y + nv.y * half }) catch {};
            right.append(alloc, .{ .x = p.x - nv.x * half, .y = p.y - nv.y * half }) catch {};
            continue;
        }
        const sPrev = if (closed) @rem(@as(usize, i + segCount - 1), segCount) else i - 1;
        const sNext = if (i < segCount) i else segCount - 1;
        const nPrev = segN.items[sPrev]; const nNext = segN.items[sNext];
        // tangent check: near-180 reversal -> emit both offsets raw
        const dot = nPrev.x * nNext.x + nPrev.y * nNext.y;
        if (dot < -0.999) {
            left.append(alloc, .{ .x = p.x + nPrev.x * half, .y = p.y + nPrev.y * half }) catch {};
            left.append(alloc, .{ .x = p.x + nNext.x * half, .y = p.y + nNext.y * half }) catch {};
            right.append(alloc, .{ .x = p.x - nPrev.x * half, .y = p.y - nPrev.y * half }) catch {};
            right.append(alloc, .{ .x = p.x - nNext.x * half, .y = p.y - nNext.y * half }) catch {};
            continue;
        }
        joinAt(p, nPrev, nNext, half, join, alloc, &left, &right);
    }
    // assemble outline: left side forward, end cap, right side backward,
    // start cap. left/right are join-expanded polylines (not per-vertex).
    var ring = std.ArrayList(V2).empty;
    defer ring.deinit(alloc);
    for (left.items) |p| ring.append(alloc, p) catch {};
    if (!closed) {
        // end cap: last point -> right side's last point
        capRun(ptsIn[m - 1], left.items[left.items.len - 1], right.items[right.items.len - 1], half, cap, alloc, &ring);
    }
    var ri: usize = right.items.len;
    while (ri > 0) : (ri -= 1) {
        ring.append(alloc, right.items[ri - 1]) catch {};
    }
    if (!closed) {
        capRun(ptsIn[0], right.items[0], left.items[0], half, cap, alloc, &ring);
    }
    return ring.toOwnedSlice(alloc) catch null;
}


// Dash segmentation: split a flattened contour into ON-run sub-contours
// under pattern [on dashLen, off dashLen] measured along arc length.
// v1: linear measure (closed contours dash linearly, no wrap — named
// delta); dashOff shifts pattern phase.
fn dashContour(c: []const V2, dashLen: f32, off: f32, alloc: std.mem.Allocator) [][]V2 {
    var out = std.ArrayList([]V2).empty;
    if (c.len < 2 or dashLen <= 0) return out.toOwnedSlice(alloc) catch &.{};
    const period = dashLen * 2;
    var pos: f32 = 0;
    var cur = std.ArrayList(V2).empty;
    var drawing = false;
    var i: usize = 0;
    while (i + 1 < c.len) : (i += 1) {
        const a = c[i]; const b = c[i + 1];
        const seglen = @sqrt(@as(f32, @floatCast(v2dist2(a, b))));
        if (seglen < 0.001) continue;
        const ux = (b.x - a.x) / seglen; const uy = (b.y - a.y) / seglen;
        var t: f32 = 0;
        while (t < seglen) : (t += 1) {
            const tend = @min(seglen, t + 1);
            const mid = pos + (t + tend) * 0.5;
            const isOn = @mod(mid + off, period) < dashLen;
            const pa = V2{ .x = a.x + ux * t, .y = a.y + uy * t };
            const pb = V2{ .x = a.x + ux * tend, .y = a.y + uy * tend };
            if (isOn and !drawing) { drawing = true; cur.clearRetainingCapacity(); cur.append(alloc, pa) catch {}; }
            if (isOn) { cur.append(alloc, pb) catch {}; }
            if (!isOn and drawing) {
                drawing = false;
                if (cur.items.len >= 2) { const cp = cur.toOwnedSlice(alloc) catch continue; out.append(alloc, cp) catch {}; }
                cur = std.ArrayList(V2).empty;
            }
        }
        pos += seglen;
    }
    if (drawing and cur.items.len >= 2) {
        const cp = cur.toOwnedSlice(alloc) catch return out.toOwnedSlice(alloc) catch &.{};
        out.append(alloc, cp) catch {};
    }
    return out.toOwnedSlice(alloc) catch &.{};
}

// stroke a verbs/pts path (may contain multiple contours) -> list of
// outline contours ready for tessellate's earClip path.
fn strokeVerbs(verbs: []const u8, pts: []const V2, thick: f32, join: i64, cap: i64, eo: i64, dash: f32, dashOff: f32, alloc: std.mem.Allocator) [][]V2 {
    const contours = flattenPath(verbs, pts, 0.25, alloc);
    defer { for (contours) |c| alloc.free(c); }
    var out = std.ArrayList([]V2).empty;
    defer out.deinit(alloc);
    for (contours) |c| {
        if (dash > 0 and c.len >= 2) {
            const runs = dashContour(c, dash, dashOff, alloc);
            defer { for (runs) |rr| alloc.free(rr); alloc.free(runs); }
            for (runs) |run| {
                const closed = v2dist2(run[0], run[run.len - 1]) < 0.01;
                if (strokeContour(run, thick, join, cap, closed, alloc)) |ring| {
                    out.append(alloc, ring) catch {};
                }
            }
            continue;
        }
        const closed = v2dist2(c[0], c[c.len - 1]) < 0.01;
        if (strokeContour(c, thick, join, cap, closed, alloc)) |ring| {
            out.append(alloc, ring) catch {};
        }
    }
    _ = eo;
    return out.toOwnedSlice(alloc) catch &.{};
}

~pub tor strokedump { r: *Riv<loaded>, ab: i64, frame: i64 }
~proc strokedump|zig {
    const alloc = std.heap.page_allocator;
    const recs = $mod.collectOps(r, @intCast(ab), frame, alloc);
    var verbs = std.ArrayList(u8).empty;
    var pts = std.ArrayList(V2).empty;
    defer verbs.deinit(alloc); defer pts.deinit(alloc);
    for (recs) |rec| {
        switch (rec.kind) {
            1, 2, 3, 4, 5 => {
                const np: usize = if (rec.kind == 1 or rec.kind == 2) 1 else if (rec.kind == 3) 2 else if (rec.kind == 4) 3 else 0;
                const base: u8 = if (rec.kind == 1) 0 else if (rec.kind == 2) 1 else if (rec.kind == 3) 2 else if (rec.kind == 4) 4 else 5;
                verbs.append(alloc, base) catch {};
                for (0..np) |k| {
                    const xs = if (k == 0) rec.x1 else if (k == 1) rec.x2 else rec.x3;
                    const ys = if (k == 0) rec.y1 else if (k == 1) rec.y2 else rec.y3;
                    pts.append(alloc, .{ .x = @floatCast(xs), .y = @floatCast(ys) }) catch {};
                }
            },
            8 => {
                if (rec.style == 0 and verbs.items.len > 0) {
                    const rings = strokeVerbs(verbs.items, pts.items, @floatCast(rec.thick), rec.join, rec.cap, rec.eo, @floatCast(rec.dash), @floatCast(rec.dashOff), alloc);
                    var total: usize = 0;
                    for (rings) |ring| {
                        const ct = earClip(ring, alloc);
                        total += ct.len;
                        for (ct) |t| {
                            std.debug.print("STROKE-TRI thick={d:.2} join={d} cap={d} {d:.4} {d:.4} {d:.4} {d:.4} {d:.4} {d:.4}\n", .{ rec.thick, rec.join, rec.cap, t.x1, t.y1, t.x2, t.y2, t.x3, t.y3 });
                        }
                        alloc.free(ring);
                        alloc.free(ct);
                    }
                    std.debug.print("STROKE-DRAW thick={d:.2} join={d} cap={d} rings={d} tris={d}\n", .{ rec.thick, rec.join, rec.cap, rings.len, total });
                    alloc.free(rings);
                }
                verbs.clearRetainingCapacity(); pts.clearRetainingCapacity();
            },
            9, 10 => { verbs.clearRetainingCapacity(); pts.clearRetainingCapacity(); },
            else => {},
        }
    }
}

// ---- meshops: OpRec stream -> tessellated triangle events -------------------
// Uniform consume path: emits per-draw MeshDrawHdr + MeshTri events the
// driver maps to canvas mesh.* verbs — identical signatures both arms.
// Fills via tessellate (eo/nonzero), strokes via strokeVerbs+earClip.
// Clips are NOT expressible as soup — named gap, not silently dropped:
// clip ops produce no events (consumer sees fewer draws, same as a
// backend without clip.push.path).

const MeshClip = struct { x0: f64, y0: f64, x1: f64, y1: f64 };
const MeshDrawHdr = struct { style: i64, color: u32, thick: f64, join: i64, cap: i64, eo: i64, ntris: usize };

~pub tor meshops { r: *Riv<loaded>, ab: i64, frame: i64 }
! mdraw MeshDrawHdr
! mtri Tri
! mdone usize
! mclip MeshClip
! mclippop usize
| mend usize

~proc meshops|zig {
    const alloc = std.heap.page_allocator;
    const recs = $mod.collectOps(r, @intCast(ab), frame, alloc);
    var verbs = std.ArrayList(u8).empty;
    var pts = std.ArrayList($mod.V2).empty;
    defer verbs.deinit(alloc); defer pts.deinit(alloc);
    // CTM mirror of canvas transform.push/pop — baked into emitted verts
    // (draw.mesh has no CTM; same convention as draw.path's raster bake).
    var ctm_stk: [16][6]f64 = undefined;
    var ctm_depth: usize = 0;
    for (recs) |rec| {
        switch (rec.kind) {
            6 => {
                if (ctm_depth < 16) { ctm_stk[ctm_depth] = .{ rec.a, rec.b, rec.c, rec.d, rec.e, rec.g }; ctm_depth += 1; }
            },
            7 => { if (ctm_depth > 0) ctm_depth -= 1; },
            1, 2, 3, 4, 5 => {
                const np: usize = if (rec.kind == 1 or rec.kind == 2) 1 else if (rec.kind == 3) 2 else if (rec.kind == 4) 3 else 0;
                const base: u8 = if (rec.kind == 1) 0 else if (rec.kind == 2) 1 else if (rec.kind == 3) 2 else if (rec.kind == 4) 4 else 5;
                verbs.append(alloc, base) catch {};
                for (0..np) |k| {
                    const xs = if (k == 0) rec.x1 else if (k == 1) rec.x2 else rec.x3;
                    const ys = if (k == 0) rec.y1 else if (k == 1) rec.y2 else rec.y3;
                    pts.append(alloc, .{ .x = @floatCast(xs), .y = @floatCast(ys) }) catch {};
                }
            },
            9 => {
                // clip push: geometry sits in verbs/pts — axis-aligned
                // rect -> scissor event; anything else is a path clip,
                // which soup can't stencil — counted gap, skipped.
                const conts = $mod.flattenPath(verbs.items, pts.items, 0.25, alloc);
                var isRect = false;
                var x0: f64 = 0; var y0: f64 = 0; var x1: f64 = 0; var y1: f64 = 0;
                if (conts.len == 1) {
                    const c = conts[0];
                    if (c.len >= 4 and c.len <= 6) {
                        var mnx: f32 = c[0].x; var mxx: f32 = c[0].x;
                        var mny: f32 = c[0].y; var mxy: f32 = c[0].y;
                        var axis = true;
                        for (c) |p| {
                            if (p.x < mnx) mnx = p.x; if (p.x > mxx) mxx = p.x;
                            if (p.y < mny) mny = p.y; if (p.y > mxy) mxy = p.y;
                        }
                        // every vertex must sit on the bbox boundary
                        for (c) |p| {
                            const onX = @abs(p.x - mnx) < 0.01 or @abs(p.x - mxx) < 0.01;
                            const onY = @abs(p.y - mny) < 0.01 or @abs(p.y - mxy) < 0.01;
                            if (!(onX or onY)) { axis = false; break; }
                            if (!(onX and onY)) {
                                // edge point must share one coord with a corner axis —
                                // for a true rect each vertex is a corner: both coords extreme
                            }
                        }
                        // stricter: 4 distinct corners
                        if (axis and (mxx - mnx) > 0.01 and (mxy - mny) > 0.01) {
                            var corners: usize = 0;
                            for (c) |p| {
                                const cx = (@abs(p.x - mnx) < 0.01 or @abs(p.x - mxx) < 0.01);
                                const cy = (@abs(p.y - mny) < 0.01 or @abs(p.y - mxy) < 0.01);
                                if (cx and cy) corners += 1;
                            }
                            if (corners >= 4) { isRect = true; x0 = mnx; y0 = mny; x1 = mxx; y1 = mxy; }
                        }
                    }
                }
                for (conts) |cc| alloc.free(cc);
                alloc.free(conts);
                if (isRect) {
                    var ctm = [6]f64{ 1, 0, 0, 1, 0, 0 };
                    for (ctm_stk[0..ctm_depth]) |m| {
                        ctm = .{ ctm[0]*m[0]+ctm[2]*m[1], ctm[1]*m[0]+ctm[3]*m[1], ctm[0]*m[2]+ctm[2]*m[3], ctm[1]*m[2]+ctm[3]*m[3], ctm[0]*m[4]+ctm[2]*m[5]+ctm[4], ctm[1]*m[4]+ctm[3]*m[5]+ctm[5] };
                    }
                    var xs: [4]f64 = undefined; var ys: [4]f64 = undefined;
                    const corners = [4][2]f64{ .{ x0, y0 }, .{ x1, y0 }, .{ x1, y1 }, .{ x0, y1 } };
                    for (corners, 0..) |cn, ci| {
                        xs[ci] = ctm[0]*cn[0] + ctm[2]*cn[1] + ctm[4];
                        ys[ci] = ctm[1]*cn[0] + ctm[3]*cn[1] + ctm[5];
                    }
                    var lo_x = xs[0]; var hi_x = xs[0]; var lo_y = ys[0]; var hi_y = ys[0];
                    for (xs, ys) |vx, vy| { if (vx < lo_x) lo_x = vx; if (vx > hi_x) hi_x = vx; if (vy < lo_y) lo_y = vy; if (vy > hi_y) hi_y = vy; }
                    const cv: $mod.MeshClip = .{ .x0 = lo_x, .y0 = lo_y, .x1 = hi_x, .y1 = hi_y };
                    mclip(cv);
                }
                verbs.clearRetainingCapacity(); pts.clearRetainingCapacity();
            },
            10 => {
                mclippop(.{ .done = 0 });
                verbs.clearRetainingCapacity(); pts.clearRetainingCapacity();
            },
            8 => {
                if (verbs.items.len > 0) {
                    var rec2 = rec;
                    if (std.posix.getenv("RIVE_NO_EO") != null) rec2.eo = 0;
                    var tris: []$mod.Tri = &.{};
                    if (rec2.style == 0) {
                        const rings = $mod.strokeVerbs(verbs.items, pts.items, @floatCast(rec2.thick), rec2.join, rec2.cap, rec2.eo, @floatCast(rec2.dash), @floatCast(rec2.dashOff), alloc);
                        var acc = std.ArrayList($mod.Tri).empty;
                        for (rings) |ring| {
                            const ct = $mod.earClip(ring, alloc);
                            for (ct) |t| acc.append(alloc, t) catch {};
                            alloc.free(ct); alloc.free(ring);
                        }
                        alloc.free(rings);
                        tris = acc.toOwnedSlice(alloc) catch &.{};
                    } else {
                        tris = $mod.tessellate(verbs.items, pts.items, rec2.eo, 0.25, alloc);
                    }
                    if (tris.len > 0) {
                        const hdr: $mod.MeshDrawHdr = .{ .style = rec2.style, .color = rec2.color, .thick = rec2.thick, .join = rec2.join, .cap = rec2.cap, .eo = rec2.eo, .ntris = tris.len };
                        mdraw(hdr);
                        // composed CTM: acc = ctmMul(acc, m) fold, identity start
                        var ctm = [6]f64{ 1, 0, 0, 1, 0, 0 };
                        if (std.posix.getenv("RIVE_TRACE_CTM") != null) {
                            std.debug.print("ctm depth={d} stk:", .{ctm_depth});
                            for (ctm_stk[0..ctm_depth]) |m| std.debug.print(" [{d:.2},{d:.2},{d:.2},{d:.2},{d:.1},{d:.1}]", .{ m[0], m[1], m[2], m[3], m[4], m[5] });
                            std.debug.print("\n", .{});
                        }
                        for (ctm_stk[0..ctm_depth]) |m| {
                            ctm = .{
                                ctm[0] * m[0] + ctm[2] * m[1],
                                ctm[1] * m[0] + ctm[3] * m[1],
                                ctm[0] * m[2] + ctm[2] * m[3],
                                ctm[1] * m[2] + ctm[3] * m[3],
                                ctm[0] * m[4] + ctm[2] * m[5] + ctm[4],
                                ctm[1] * m[4] + ctm[3] * m[5] + ctm[5],
                            };
                        }
                        if (std.posix.getenv("RIVE_TRACE_TRIS") != null) {
                            var bx0: f64 = 1e18; var by0: f64 = 1e18; var bx1: f64 = -1e18; var by1: f64 = -1e18;
                            for (tris) |t| {
                                const vs = [6]f64{ t.x1, t.y1, t.x2, t.y2, t.x3, t.y3 };
                                for (vs, 0..) |v, vi| {
                                    const txv = if (vi % 2 == 0) v else v; _ = txv;
                                }
                                for ([_]f64{ t.x1, t.x2, t.x3 }) |vx| { const wx = ctm[0]*vx + ctm[4]; if (wx < bx0) bx0 = wx; if (wx > bx1) bx1 = wx; }
                                for ([_]f64{ t.y1, t.y2, t.y3 }) |vy| { const wy = ctm[1]*vy + ctm[5]; if (wy < by0) by0 = wy; if (wy > by1) by1 = wy; }
                            }
                            std.debug.print("tris n={d} ctmdepth={d} bbox=({d:.0},{d:.0})-({d:.0},{d:.0})\n", .{ tris.len, ctm_depth, bx0, by0, bx1, by1 });
                        }
                        for (tris) |t| {
                            const tx = [3]f64{ @floatCast(t.x1), @floatCast(t.x2), @floatCast(t.x3) };
                            const ty = [3]f64{ @floatCast(t.y1), @floatCast(t.y2), @floatCast(t.y3) };
                            const tv: $mod.Tri = .{
                                .x1 = @floatCast(ctm[0] * tx[0] + ctm[2] * ty[0] + ctm[4]),
                                .y1 = @floatCast(ctm[1] * tx[0] + ctm[3] * ty[0] + ctm[5]),
                                .x2 = @floatCast(ctm[0] * tx[1] + ctm[2] * ty[1] + ctm[4]),
                                .y2 = @floatCast(ctm[1] * tx[1] + ctm[3] * ty[1] + ctm[5]),
                                .x3 = @floatCast(ctm[0] * tx[2] + ctm[2] * ty[2] + ctm[4]),
                                .y3 = @floatCast(ctm[1] * tx[2] + ctm[3] * ty[2] + ctm[5]),
                            };
                            mtri(tv);
                        }
                        mdone(tris.len);
                        alloc.free(tris);
                    }
                }
                verbs.clearRetainingCapacity(); pts.clearRetainingCapacity();
            },
            else => {},
        }
    }
    return .{ .mend = 0 };
}
