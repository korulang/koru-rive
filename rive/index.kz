// .riv runtime-file inspector — phase 1 of the Koru-native Rive runtime.
// Parses the RuntimeHeader (RIVE fingerprint, versions, fileId, the
// property ToC's 2-bit field indices) then walks the object stream:
// typeKey varuint, property key/value pairs to the 0 terminator, values
// skipped by field type exactly as rive-cpp's readRuntimeObject does.
// Schema tables below are GENERATED from rive-cpp's generated headers +
// core_registry.hpp propertyFieldId switch (see tools/extract_schema.py).
//
// Usage: koru-rive/inspect.k drives `inspect(path:)`.

const std = @import("std");

const TypeKeyEntry = struct { key: u64, name: [:0]const u8 };
const PropEntry = struct { key: u16, field: i8, name: [:0]const u8 };

fn zsearch(comptime T: type, key: u64, items: []const T, keyOf: fn(T) u64) ?T {
    var lo: usize = 0;
    var hi: usize = items.len;
    while (lo < hi) {
        const mid = (lo + hi) / 2;
        if (keyOf(items[mid]) < key) lo = mid + 1 else hi = mid;
    }
    if (lo < items.len and keyOf(items[lo]) == key) return items[lo];
    return null;
}

