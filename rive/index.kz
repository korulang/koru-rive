    .{ .key = 1075, .field = 0, .name = "ImageAsset.samplerWrapY" },
    .{ .key = 1076, .field = 0, .name = "Image.samplerFilter" },
    .{ .key = 1077, .field = 0, .name = "Image.samplerWrapX" },
    .{ .key = 1078, .field = 0, .name = "Image.samplerWrapY" },
    .{ .key = 1087, .field = 0, .name = "ScriptModuleAsset.language" },
    .{ .key = 1094, .field = 0, .name = "TextInput.verticalAlignValue" },
    .{ .key = 1095, .field = 4, .name = "TextInput.obscured" },
    .{ .key = 1098, .field = 4, .name = "NestedArtboardLeaf.fitToLayoutParent" },
    .{ .key = 1099, .field = 4, .name = "TextInput.selectAllOnFocus" },
    .{ .key = 1103, .field = 2, .name = "LinearGradient.transformX" },
    .{ .key = 1104, .field = 2, .name = "LinearGradient.transformY" },
    .{ .key = 1105, .field = 2, .name = "LinearGradient.transformRotation" },
    .{ .key = 1106, .field = 2, .name = "LinearGradient.transformScaleX" },
    .{ .key = 1107, .field = 2, .name = "LinearGradient.transformScaleY" },
    .{ .key = 1124, .field = 1, .name = "TextInput.language" },
    .{ .key = 1125, .field = 0, .name = "TextInput.languageId" },
    .{ .key = 1126, .field = 1, .name = "Text.language" },
